---
export interface Props {
  title: string
  note?: string
  unit?: string
  data: { label: string; value: number }[]
}

const { title, note, unit = '', data } = Astro.props
const maxAbs = Math.max(...data.map((d) => Math.abs(d.value)))
---

<figure class="blog-deltachart">
  <figcaption>
    {title}
    {note && <span class="delta-note">{note}</span>}
  </figcaption>
  <ul role="list">
    {data.map((d) => (
      <li>
        <span class="delta-label">{d.label}</span>
        <span class="delta-track">
          <span
            class={`delta-fill ${d.value < 0 ? 'is-neg' : 'is-pos'}`}
            style={`width:${((Math.abs(d.value) / maxAbs) * 50).toFixed(1)}%`}
          ></span>
        </span>
        <span class="delta-value">{d.value > 0 ? '+' : ''}{d.value}{unit}</span>
      </li>
    ))}
  </ul>
</figure>

<style>
  .blog-deltachart {
    margin: 28px 0;
    padding: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  figcaption {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 16px;
  }
  .delta-note {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--text-dim);
    margin-top: 4px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  li {
    display: grid;
    grid-template-columns: 132px 1fr 64px;
    gap: 12px;
    align-items: center;
  }
  .delta-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .delta-track {
    position: relative;
    height: 12px;
    background: var(--bg-elevated);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .delta-track::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border-light);
  }
  .delta-fill {
    position: absolute;
    top: 1px;
    bottom: 1px;
    min-width: 2px;
  }
  .delta-fill.is-pos {
    left: 50%;
    background: var(--red);
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
  }
  .delta-fill.is-neg {
    right: 50%;
    background: var(--accent);
    border-radius: var(--radius-pill) 0 0 var(--radius-pill);
  }
  .delta-value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    text-align: right;
  }
  @media (max-width: 560px) {
    li { grid-template-columns: 90px 1fr 56px; gap: 8px; }
  }
</style>
