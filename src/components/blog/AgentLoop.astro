---
const steps = [
  { title: 'Before a tool runs', acts: ['Block', 'Rewrite', 'Route'], where: 'inside your agent' },
  { title: 'After a tool runs', acts: ['Filter', 'Compress', 'Route'], where: 'inside your agent' },
  { title: 'The conversation goes to the model', acts: ['Compress', 'Cache'], where: 'RTK Proxy', proxy: true },
]
---

<figure class="blog-loop">
  <ol class="loop-steps">
    {steps.map((s, i) => (
      <li class:list={['loop-step', { 'is-proxy': s.proxy }]}>
        <span class="loop-n">{i + 1}</span>
        <span class="loop-title">{s.title}</span>
        <span class="loop-acts">{s.acts.map(a => <span>{a}</span>)}</span>
        <span class="loop-tag">{s.where}</span>
      </li>
    ))}
  </ol>
  <div class="loop-back" aria-hidden="true">
    <span class="loop-back-line"></span>
    <span class="loop-back-label">↺ every turn, again</span>
  </div>
  <figcaption>Every turn of a coding agent goes through these three steps. RTK can act at each one.</figcaption>
</figure>

<style>
  .blog-loop {
    margin: 32px 0;
    padding: 22px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .blog-loop .loop-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .loop-steps .loop-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .loop-step + .loop-step::before {
    content: '→';
    position: absolute;
    left: -22px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 16px;
    line-height: 1;
  }
  .loop-n {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .loop-title {
    color: var(--text-bright);
    font-weight: 600;
    line-height: 1.35;
  }
  .loop-tag {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .loop-acts { display: flex; flex-wrap: wrap; gap: 6px; }
  .loop-acts span {
    padding: 2px 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: 999px;
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .is-proxy {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
  }
  .loop-back {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .loop-back-line {
    flex: 1;
    height: 14px;
    border: 1px dashed var(--border);
    border-top: 0;
    border-radius: 0 0 10px 10px;
  }
  .loop-back-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }
  figcaption {
    margin-top: 14px;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .blog-loop .loop-steps { grid-template-columns: 1fr; gap: 22px; }
    .loop-step + .loop-step::before {
      content: '↓';
      left: 50%;
      top: -18px;
      transform: translateX(-50%);
    }
    .loop-back-line { border-top: 0; }
  }
</style>
