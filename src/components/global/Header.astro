---
/**
 * Docs header: renders the full SiteHeader so /guide/* matches
 * the landing nav exactly. No globe (docs are EN-only).
 */
import SiteHeader from './SiteHeader.astro'
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <img src="/brand/logo.png" alt="rtk logo" width="26" height="26" style="border-radius:var(--radius-sm);">
      <span>rtk</span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label="Main navigation">
      <a href="/#problem" class="header-link">Why</a>
      <a href="/#install" class="header-link">Install</a>
      <span class="header-divider" aria-hidden="true"></span>
      <a href="/docs/" class="header-link header-link--active">Docs</a>
      <a href="/savings/" class="header-link">Savings</a>
      <span class="header-divider" aria-hidden="true"></span>
      <button id="search-trigger" class="header-search-btn" aria-label="Search (Cmd+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="header-search-label">Search</span>
        <kbd class="header-search-kbd">⌘K</kbd>
      </button>
      <a href="https://github.com/rtk-ai/rtk" class="header-btn-ghost" target="_blank" rel="noopener">
        <IconGitHub size={14} />
        GitHub
      </a>
    </nav>

    <!-- Mobile right: search + hamburger -->
    <div class="header-mobile-right">
      <button id="docs-search-trigger-mobile" class="header-icon-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
      <button class="header-icon-btn header-hamburger" id="docs-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="docs-drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div class="docs-drawer" id="docs-drawer" aria-hidden="true">
  <div class="docs-drawer-inner">
    <div class="docs-drawer-links">
      <a href="/#problem">Why</a>
      <a href="/#install">Install</a>
      <a href="/docs/" class="active">Docs</a>
      <a href="/savings/">Savings</a>
    </div>
    <div class="docs-drawer-actions">
      <a href="https://github.com/rtk-ai/rtk" target="_blank" rel="noopener">
        <IconGitHub size={14} />
        GitHub
      </a>
    </div>
  </div>
</div>
<div class="docs-overlay" id="docs-overlay"></div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 60px;
    background: var(--bg-glass);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
    color: var(--text-bright);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .header-logo:hover { text-decoration: none; color: var(--text-bright); }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .header-divider {
    width: 1px;
    height: 18px;
    background: var(--border);
    margin: 0 6px;
    flex-shrink: 0;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: color 150ms ease, background 150ms ease;
  }
  .header-link:hover {
    color: var(--text);
    background: var(--bg-card);
    text-decoration: none;
  }
  .header-link--active { color: var(--text); }
  .header-link--vox { color: #a78bfa; }
  .header-link--vox:hover { color: #a78bfa; background: rgba(167,139,250,0.08); }
  .header-link--icm { color: #38bdf8; }
  .header-link--icm:hover { color: #38bdf8; background: rgba(56,189,248,0.08); }

  .header-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    margin-left: 4px;
  }
  .header-btn-ghost:hover {
    color: var(--text);
    border-color: var(--border-light);
    background: var(--bg-card);
    text-decoration: none;
  }

  .header-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: transparent;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    margin-left: 4px;
  }
  .header-search-btn:hover {
    color: var(--text);
    border-color: var(--border-light);
    background: var(--bg-card);
  }
  .header-search-label {
    color: var(--text-dim);
    font-size: 0.8125rem;
  }
  .header-search-kbd {
    display: inline-flex;
    align-items: center;
    padding: 1px 5px;
    font-size: 0.6875rem;
    color: var(--text-dim);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: inherit;
  }

  /* Mobile controls — hidden on desktop */
  .header-mobile-right {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .header-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    padding: 0;
  }
  .header-icon-btn:hover {
    color: var(--text);
    border-color: var(--border-light);
    background: var(--bg-card);
  }

  .header-hamburger {
    flex-direction: column;
    gap: 5px;
  }
  .header-hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Drawer */
  .docs-drawer {
    position: fixed;
    top: 60px;
    right: 0;
    bottom: 0;
    width: min(280px, 80vw);
    background: var(--bg-alt);
    border-left: 1px solid var(--border);
    z-index: 200;
    transform: translateX(100%);
    transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
    display: none;
  }
  .docs-drawer.open {
    transform: translateX(0);
  }

  .docs-drawer-inner {
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    height: 100%;
    gap: 32px;
  }

  .docs-drawer-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .docs-drawer-links a {
    display: block;
    padding: 12px 16px;
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 8px;
    transition: color 150ms ease, background 150ms ease;
  }
  .docs-drawer-links a:hover {
    color: var(--text);
    background: var(--bg-card);
  }
  .docs-drawer-links a.active {
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }

  .docs-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .docs-drawer-actions a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .docs-drawer-actions a:hover {
    color: var(--text);
    border-color: var(--border-light);
    background: var(--bg-card);
  }

  /* Overlay */
  .docs-overlay {
    display: none;
    position: fixed;
    inset: 60px 0 0 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
    z-index: 199;
  }
  .docs-overlay.open { display: block; }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0 16px;
      gap: 0;
    }
    .header-nav {
      display: none;
    }
    .header-mobile-right {
      display: flex;
    }
    .docs-drawer {
      display: block;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('docs-hamburger')
  const drawer = document.getElementById('docs-drawer')
  const overlay = document.getElementById('docs-overlay')
  const searchMobile = document.getElementById('docs-search-trigger-mobile')
  const searchDesktop = document.getElementById('search-trigger')

  function openDrawer() {
    drawer?.classList.add('open')
    overlay?.classList.add('open')
    hamburger?.setAttribute('aria-expanded', 'true')
    drawer?.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  function closeDrawer() {
    drawer?.classList.remove('open')
    overlay?.classList.remove('open')
    hamburger?.setAttribute('aria-expanded', 'false')
    drawer?.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
  }

  hamburger?.addEventListener('click', () => {
    drawer?.classList.contains('open') ? closeDrawer() : openDrawer()
  })

  overlay?.addEventListener('click', closeDrawer)
  drawer?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeDrawer))
  searchMobile?.addEventListener('click', () => {
    closeDrawer()
    searchDesktop?.click()
  })
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer() })
</script>
