---
import IconGitHub from '../ui/icons/IconGitHub.astro'
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <img src="/brand/logo.png" alt="rtk logo" width="26" height="26" style="border-radius:var(--radius-sm);">
      <span>rtk</span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label="Main navigation">
      <a href="/#problem" class="header-link">Why</a>
      <a href="/#install" class="header-link">Install</a>
      <span class="header-divider" aria-hidden="true"></span>
      <a href="/guide/" class="header-link header-link--active">Docs</a>
      <span class="header-divider" aria-hidden="true"></span>
      <button id="search-trigger" class="header-search-btn" aria-label="Search (Cmd+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="header-search-label">Search</span>
        <kbd class="header-search-kbd">⌘K</kbd>
      </button>
      <a href="https://github.com/rtk-ai/rtk" class="header-btn-ghost" target="_blank" rel="noopener">
        <IconGitHub size={14} />
        GitHub
      </a>
    </nav>

    <!-- Mobile right: search + sidebar toggle -->
    <div class="header-mobile-right">
      <button id="docs-search-trigger-mobile" class="header-icon-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
      <button class="header-icon-btn header-hamburger" id="docs-hamburger" aria-label="Open docs navigation" aria-expanded="false" aria-controls="starlight__sidebar">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 60px;
    background: rgba(6, 11, 24, 0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .header-logo:hover { text-decoration: none; color: #f8fafc; }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .header-divider {
    width: 1px;
    height: 18px;
    background: var(--border);
    margin: 0 6px;
    flex-shrink: 0;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: color 150ms ease, background 150ms ease;
  }
  .header-link:hover {
    color: var(--text);
    background: var(--bg-card);
    text-decoration: none;
  }
  .header-link--active { color: var(--text); }

  .header-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    margin-left: 4px;
  }
  .header-btn-ghost:hover {
    color: var(--text);
    border-color: #243056;
    background: var(--bg-card);
    text-decoration: none;
  }

  .header-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: transparent;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    margin-left: 4px;
  }
  .header-search-btn:hover {
    color: var(--text);
    border-color: #243056;
    background: var(--bg-card);
  }
  .header-search-label {
    color: #64748b;
    font-size: 0.8125rem;
  }
  .header-search-kbd {
    display: inline-flex;
    align-items: center;
    padding: 1px 5px;
    font-size: 0.6875rem;
    color: #64748b;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: inherit;
  }

  /* Mobile controls — hidden on desktop */
  .header-mobile-right {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .header-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: rgba(15, 22, 41, 0.6);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    padding: 0;
  }
  .header-icon-btn:hover {
    color: var(--text);
    border-color: #243056;
    background: var(--bg-card);
  }

  .header-hamburger {
    flex-direction: column;
    gap: 5px;
  }
  .header-hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 50rem) {
    .header-inner {
      padding: 0 16px;
      gap: 8px;
    }
    .header-nav {
      display: none;
    }
    .header-mobile-right {
      display: flex;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('docs-hamburger')
  const searchMobile = document.getElementById('docs-search-trigger-mobile')
  const searchDesktop = document.getElementById('search-trigger')

  const slEl = document.querySelector('starlight-menu-button')

  if (slEl) {
    const innerBtn = slEl.querySelector('button')
    const syncState = () => {
      const expanded = slEl.getAttribute('aria-expanded') === 'true'
      hamburger?.setAttribute('aria-expanded', String(expanded))
    }
    hamburger?.addEventListener('click', () => innerBtn?.click())
    new MutationObserver(syncState).observe(slEl, {
      attributes: true,
      attributeFilter: ['aria-expanded'],
    })
  } else if (hamburger) {
    hamburger.style.display = 'none'
  }

  searchMobile?.addEventListener('click', () => searchDesktop?.click())
</script>
