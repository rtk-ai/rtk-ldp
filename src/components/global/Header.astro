---
// Header.astro — RTK docs nav header, with mobile drawer
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <img src="/brand/logo.png" alt="rtk logo" width="26" height="26" style="border-radius:var(--radius-sm);">
      <span>rtk</span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label="Main navigation">
      <a href="/#problem" class="header-link">Why</a>
      <a href="/#install" class="header-link">Install</a>
      <span class="header-divider" aria-hidden="true"></span>
      <a href="/guide/" class="header-link header-link--active">Docs</a>
      <a href="/vox/" class="header-link header-link--vox">Vox</a>
      <a href="/icm/" class="header-link header-link--icm">ICM</a>
      <span class="header-divider" aria-hidden="true"></span>
      <button id="search-trigger" class="header-search-btn" aria-label="Search (Cmd+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="header-search-label">Search</span>
        <kbd class="header-search-kbd">⌘K</kbd>
      </button>
      <a href="https://github.com/rtk-ai/rtk" class="header-btn-ghost" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub
      </a>
    </nav>

    <!-- Mobile right: search + hamburger -->
    <div class="header-mobile-right">
      <button id="docs-search-trigger-mobile" class="header-icon-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
      <button class="header-icon-btn header-hamburger" id="docs-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="docs-drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div class="docs-drawer" id="docs-drawer" aria-hidden="true">
  <div class="docs-drawer-inner">
    <div class="docs-drawer-links">
      <a href="/#problem">Why</a>
      <a href="/#install">Install</a>
      <a href="/guide/" class="active">Docs</a>
      <a href="/vox/" class="link-vox">Vox</a>
      <a href="/icm/" class="link-icm">ICM</a>
    </div>
    <div class="docs-drawer-actions">
      <a href="https://github.com/rtk-ai/rtk" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</div>
<div class="docs-overlay" id="docs-overlay"></div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 60px;
    background: rgba(6, 11, 24, 0.92);
    border-bottom: 1px solid #1a2344;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .header-logo:hover { text-decoration: none; color: #f8fafc; }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .header-divider {
    width: 1px;
    height: 18px;
    background: #1a2344;
    margin: 0 6px;
    flex-shrink: 0;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    color: #8294ab;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: color 150ms ease, background 150ms ease;
  }
  .header-link:hover {
    color: #e2e8f0;
    background: #0f1629;
    text-decoration: none;
  }
  .header-link--active { color: #e2e8f0; }
  .header-link--vox { color: #a78bfa; }
  .header-link--vox:hover { color: #a78bfa; background: rgba(167,139,250,0.08); }
  .header-link--icm { color: #38bdf8; }
  .header-link--icm:hover { color: #38bdf8; background: rgba(56,189,248,0.08); }

  .header-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    color: #8294ab;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid #1a2344;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    margin-left: 4px;
  }
  .header-btn-ghost:hover {
    color: #e2e8f0;
    border-color: #243056;
    background: #0f1629;
    text-decoration: none;
  }

  .header-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    color: #8294ab;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid #1a2344;
    background: transparent;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    margin-left: 4px;
  }
  .header-search-btn:hover {
    color: #e2e8f0;
    border-color: #243056;
    background: #0f1629;
  }
  .header-search-label {
    color: #64748b;
    font-size: 0.8125rem;
  }
  .header-search-kbd {
    display: inline-flex;
    align-items: center;
    padding: 1px 5px;
    font-size: 0.6875rem;
    color: #64748b;
    background: #0c1225;
    border: 1px solid #1a2344;
    border-radius: 4px;
    font-family: inherit;
  }

  /* Mobile controls — hidden on desktop */
  .header-mobile-right {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .header-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid #1a2344;
    background: rgba(15, 22, 41, 0.6);
    color: #8294ab;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    padding: 0;
  }
  .header-icon-btn:hover {
    color: #e2e8f0;
    border-color: #243056;
    background: #0f1629;
  }

  .header-hamburger {
    flex-direction: column;
    gap: 5px;
  }
  .header-hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Drawer */
  .docs-drawer {
    position: fixed;
    top: 60px;
    right: 0;
    bottom: 0;
    width: min(280px, 80vw);
    background: #0c1225;
    border-left: 1px solid #1a2344;
    z-index: 200;
    transform: translateX(100%);
    transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
    display: none;
  }
  .docs-drawer.open {
    transform: translateX(0);
  }

  .docs-drawer-inner {
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    height: 100%;
    gap: 32px;
  }

  .docs-drawer-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .docs-drawer-links a {
    display: block;
    padding: 12px 16px;
    color: #8294ab;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 8px;
    transition: color 150ms ease, background 150ms ease;
  }
  .docs-drawer-links a:hover {
    color: #e2e8f0;
    background: #0f1629;
  }
  .docs-drawer-links a.active {
    color: #e2e8f0;
    background: rgba(255,255,255,0.04);
  }
  .docs-drawer-links a.link-vox { color: #a78bfa; }
  .docs-drawer-links a.link-vox:hover { background: rgba(167,139,250,0.08); }
  .docs-drawer-links a.link-icm { color: #38bdf8; }
  .docs-drawer-links a.link-icm:hover { background: rgba(56,189,248,0.08); }

  .docs-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .docs-drawer-actions a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    color: #8294ab;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    border: 1px solid #1a2344;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .docs-drawer-actions a:hover {
    color: #e2e8f0;
    border-color: #243056;
    background: #0f1629;
  }

  /* Overlay */
  .docs-overlay {
    display: none;
    position: fixed;
    inset: 60px 0 0 0;
    background: rgba(6, 11, 24, 0.6);
    backdrop-filter: blur(2px);
    z-index: 199;
  }
  .docs-overlay.open { display: block; }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0 16px;
      gap: 0;
    }
    .header-nav {
      display: none;
    }
    .header-mobile-right {
      display: flex;
    }
    .docs-drawer {
      display: block;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('docs-hamburger')
  const drawer = document.getElementById('docs-drawer')
  const overlay = document.getElementById('docs-overlay')
  const searchMobile = document.getElementById('docs-search-trigger-mobile')
  const searchDesktop = document.getElementById('search-trigger')

  function openDrawer() {
    drawer?.classList.add('open')
    overlay?.classList.add('open')
    hamburger?.setAttribute('aria-expanded', 'true')
    drawer?.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  function closeDrawer() {
    drawer?.classList.remove('open')
    overlay?.classList.remove('open')
    hamburger?.setAttribute('aria-expanded', 'false')
    drawer?.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
  }

  hamburger?.addEventListener('click', () => {
    drawer?.classList.contains('open') ? closeDrawer() : openDrawer()
  })

  overlay?.addEventListener('click', closeDrawer)
  drawer?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeDrawer))
  searchMobile?.addEventListener('click', () => {
    closeDrawer()
    searchDesktop?.click()
  })
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer() })
</script>
