---
import IconGitHub from '../ui/icons/IconGitHub.astro'
import IconDiscord from '../ui/icons/IconDiscord.astro'
import IconKofi from '../ui/icons/IconKofi.astro'
import IconStar from '../ui/icons/IconStar.astro'

const currentYear = new Date().getFullYear()

let version = 'v0.37.1'

try {
  const headers: Record<string, string> = { 'User-Agent': 'rtk-landing' }
  const token = process.env.GITHUB_TOKEN
  if (token) headers['Authorization'] = `Bearer ${token}`

  const res = await fetch('https://api.github.com/repos/rtk-ai/rtk/releases/latest', { headers })
  if (res.ok) {
    const data = await res.json()
    if (data.tag_name) version = data.tag_name.startsWith('v') ? data.tag_name : `v${data.tag_name}`
  }
} catch {}
---

<footer class="site-footer">

  <!-- Pre-footer CTA strip -->
  <div class="footer-cta-strip">
    <div class="footer-cta-inner">
      <div class="footer-cta-text">
        <p class="footer-cta-title">Your AI already runs rtk.</p>
        <p class="footer-cta-sub">Join <strong>18k+ developers</strong> who cut token costs by 60-90%.</p>
      </div>
      <div class="footer-cta-actions">
        <a href="#install" class="btn btn-primary btn-sm">Install rtk</a>
        <a href="https://github.com/rtk-ai/rtk" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
          <IconGitHub size={14} />
          Star on GitHub
        </a>
      </div>
    </div>
  </div>

  <!-- Main footer grid -->
  <div class="footer-main">
    <div class="footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/brand/logo.png" alt="rtk logo" width="22" height="22" style="border-radius:var(--radius-xs);">
          <span>rtk</span>
        </a>
        <p class="footer-tagline">Rust Token Killer — reduce Claude Code token usage by 60-90% with zero config.</p>
        <div class="footer-version">
          <span class="footer-version-badge">
            <IconStar size={12} filled />
            Open Source
          </span>
          <span class="footer-version-tag">{version}</span>
        </div>
        <div class="footer-social">
          <a href="https://github.com/rtk-ai/rtk" class="footer-social-btn" target="_blank" rel="noopener" aria-label="GitHub">
            <IconGitHub size={16} />
          </a>
          <a href="https://discord.gg/RySmvNF5kF" class="footer-social-btn footer-social-btn--discord" target="_blank" rel="noopener" aria-label="Discord">
            <IconDiscord size={16} />
          </a>
          <a href="https://ko-fi.com/patrickszymkowiak" class="footer-social-btn footer-social-btn--kofi" target="_blank" rel="noopener" aria-label="Support on Ko-fi">
            <IconKofi size={16} />
          </a>
        </div>
      </div>

      <!-- Install column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Install</h3>
        <ul class="footer-col-links">
          <li><a href="#install">Homebrew</a></li>
          <li><a href="#install">One-liner (curl)</a></li>
          <li><a href="#install">Via Cargo</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/releases" target="_blank" rel="noopener">Pre-built Binaries</a></li>
          <li><a href="/guide/">Getting Started</a></li>
          <li><a href="/guide/features/">Features</a></li>
        </ul>
      </div>

      <!-- Docs column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Docs</h3>
        <ul class="footer-col-links">
          <li><a href="/guide/">Guide</a></li>
          <li><a href="/guide/getting-started/installation/">Installation</a></li>
          <li><a href="/guide/getting-started/quick-start/">Quick Start</a></li>
          <li><a href="/guide/what-rtk-covers/">What RTK Optimizes</a></li>
          <li><a href="/guide/troubleshooting/">Troubleshooting</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/blob/master/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a></li>
        </ul>
      </div>

      <!-- Products column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Products</h3>
        <ul class="footer-col-links">
          <li>
            <a href="/vox/" class="footer-link-product footer-link-vox">
              <span class="footer-product-dot footer-product-dot--vox"></span>
              Vox
            </a>
          </li>
          <li>
            <a href="/icm/" class="footer-link-product footer-link-icm">
              <span class="footer-product-dot footer-product-dot--icm"></span>
              ICM
            </a>
          </li>
          <li>
            <a href="#cloud" class="footer-link-product">
              <span class="footer-product-dot footer-product-dot--cloud"></span>
              RTK Cloud
              <span class="footer-badge-soon">Soon</span>
            </a>
          </li>
        </ul>
        <h3 class="footer-col-title" style="margin-top:24px;">Legal</h3>
        <ul class="footer-col-links">
          <li><a href="https://github.com/rtk-ai/rtk/blob/master/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/blob/master/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
        </ul>
      </div>

      <!-- Community column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Community</h3>
        <ul class="footer-col-links">
          <li><a href="/team/">Team</a></li>
          <li><a href="https://github.com/rtk-ai/rtk" target="_blank" rel="noopener">GitHub Repo</a></li>
          <li><a href="https://discord.gg/RySmvNF5kF" target="_blank" rel="noopener">Discord Server</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/issues" target="_blank" rel="noopener">Report Issues</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/discussions" target="_blank" rel="noopener">Discussions</a></li>
          <li><a href="https://twitter.com/intent/tweet?url=https://www.rtk-ai.app&text=Cut+Claude+Code+token+costs+by+60-90%25+with+RTK" target="_blank" rel="noopener">Share on X</a></li>
          <li><a href="https://ko-fi.com/patrickszymkowiak" target="_blank" rel="noopener">Support the project</a></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-bottom-left">
        <span class="footer-copyright">MIT License</span>
        <span class="footer-bottom-sep">&middot;</span>
        Built by RTK Team
        <span class="footer-bottom-sep">&middot;</span>
        &copy; {currentYear} rtk-ai
      </p>
      <p class="footer-bottom-right">
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
        <span class="footer-bottom-sep">&middot;</span>
        Deployed on
        <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a>
      </p>
    </div>
  </div>

</footer>
