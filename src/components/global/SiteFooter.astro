---
import IconGitHub from '../ui/icons/IconGitHub.astro'
import IconDiscord from '../ui/icons/IconDiscord.astro'
import IconKofi from '../ui/icons/IconKofi.astro'
import IconStar from '../ui/icons/IconStar.astro'

const currentYear = new Date().getFullYear()

let version = 'v0.37.1'

try {
  const headers: Record<string, string> = { 'User-Agent': 'rtk-landing' }
  const token = process.env.GITHUB_TOKEN
  if (token) headers['Authorization'] = `Bearer ${token}`

  const res = await fetch('https://api.github.com/repos/rtk-ai/rtk/releases/latest', { headers })
  if (res.ok) {
    const data = await res.json()
    if (data.tag_name) version = data.tag_name.startsWith('v') ? data.tag_name : `v${data.tag_name}`
  }
} catch {}
---

<footer class="site-footer">

  <!-- Pre-footer CTA strip -->
  <div class="footer-cta-strip">
    <div class="footer-cta-inner">
      <div class="footer-cta-text">
        <p class="footer-cta-title">Your AI already runs rtk.</p>
        <p class="footer-cta-sub">Join <strong>18k+ developers</strong> who cut token costs by 60-90%.</p>
      </div>
      <div class="footer-cta-actions">
        <a href="/#install" class="btn btn-primary btn-sm">Install rtk</a>
        <a href="https://github.com/rtk-ai/rtk" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
          <IconGitHub size={14} />
          Star on GitHub
        </a>
      </div>
    </div>
  </div>

  <!-- Main footer grid -->
  <div class="footer-main">
    <div class="footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/brand/logo.png" alt="rtk logo" width="22" height="22" style="border-radius:var(--radius-xs);">
          <span>rtk</span>
        </a>
        <p class="footer-tagline">Rust Token Killer — reduce Claude Code token usage by 60-90% with zero config.</p>
        <div class="footer-version">
          <span class="footer-version-badge">
            <IconStar size={12} filled />
            Open Source
          </span>
          <span class="footer-version-tag">{version}</span>
        </div>
        <div class="footer-social">
          <a href="https://github.com/rtk-ai/rtk" class="footer-social-btn" target="_blank" rel="noopener" aria-label="GitHub">
            <IconGitHub size={16} />
          </a>
          <a href="https://discord.gg/RySmvNF5kF" class="footer-social-btn footer-social-btn--discord" target="_blank" rel="noopener" aria-label="Discord">
            <IconDiscord size={16} />
          </a>
          <a href="https://ko-fi.com/patrickszymkowiak" class="footer-social-btn footer-social-btn--kofi" target="_blank" rel="noopener" aria-label="Support on Ko-fi">
            <IconKofi size={16} />
          </a>
        </div>
      </div>

      <!-- Install column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Install</h3>
        <ul class="footer-col-links">
          <li><a href="/#install">Homebrew</a></li>
          <li><a href="/#install">One-liner (curl)</a></li>
          <li><a href="/#install">Via Cargo</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/releases" target="_blank" rel="noopener">Pre-built Binaries</a></li>
          <li><a href="/guide/">Getting Started</a></li>
          <li><a href="/savings/">Token Savings</a></li>
        </ul>
      </div>

      <!-- Docs column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Docs</h3>
        <ul class="footer-col-links">
          <li><a href="/guide/">Guide</a></li>
          <li><a href="/guide/getting-started/installation/">Installation</a></li>
          <li><a href="/guide/getting-started/quick-start/">Quick Start</a></li>
          <li><a href="/guide/what-rtk-covers/">What RTK Optimizes</a></li>
          <li><a href="/guide/troubleshooting/">Troubleshooting</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/blob/master/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a></li>
        </ul>
      </div>

      <!-- Products column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Products</h3>
        <ul class="footer-col-links">
          <li>
            <a href="/cloud/" class="footer-link-product">
              <span class="footer-product-dot footer-product-dot--cloud"></span>
              RTK Cloud
              <span class="footer-badge-soon">Soon</span>
            </a>
          </li>
        </ul>
        <h3 class="footer-col-title" style="margin-top:24px;">Explore</h3>
        <ul class="footer-col-links">
          <li><a href="/savings/">Token Savings</a></li>
          <li><a href="/vs/">Compare Tools</a></li>
        </ul>
        <h3 class="footer-col-title" style="margin-top:24px;">Legal</h3>
        <ul class="footer-col-links">
          <li><a href="https://github.com/rtk-ai/rtk/blob/master/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/blob/master/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
          <li><a href="#" onclick="window.rtkConsentReset(); return false;">Cookie preferences</a></li>
        </ul>
      </div>

      <!-- Community column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Community</h3>
        <ul class="footer-col-links">
          <li><a href="/team/">Team</a></li>
          <li><a href="https://github.com/rtk-ai/rtk" target="_blank" rel="noopener">GitHub Repo</a></li>
          <li><a href="https://discord.gg/RySmvNF5kF" target="_blank" rel="noopener">Discord Server</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/issues" target="_blank" rel="noopener">Report Issues</a></li>
          <li><a href="https://github.com/rtk-ai/rtk/discussions" target="_blank" rel="noopener">Discussions</a></li>
          <li><a href="https://twitter.com/intent/tweet?url=https://www.rtk-ai.app&text=Cut+Claude+Code+token+costs+by+60-90%25+with+RTK" target="_blank" rel="noopener">Share on X</a></li>
          <li><a href="https://ko-fi.com/patrickszymkowiak" target="_blank" rel="noopener">Support the project</a></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-bottom-left">
        <span class="footer-copyright">MIT License</span>
        <span class="footer-bottom-sep">&middot;</span>
        Built by RTK Team
        <span class="footer-bottom-sep">&middot;</span>
        &copy; {currentYear} rtk-ai
      </p>
      <p class="footer-bottom-right">
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
        <span class="footer-bottom-sep">&middot;</span>
        Deployed on
        <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a>
      </p>
    </div>
  </div>

</footer>

<style>
.site-footer {
  border-top: 1px solid var(--border);
  background: var(--bg-alt);
}

/* Pre-footer CTA strip */
.footer-cta-strip {
  border-bottom: 1px solid var(--border);
  padding: 28px 0;
}
.footer-cta-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-5);
  flex-wrap: wrap;
}
.footer-cta-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-bright);
  margin-bottom: 4px;
}
.footer-cta-sub {
  font-size: var(--text-sm);
  color: var(--text-muted);
}
.footer-cta-sub strong { color: var(--text); }
.footer-cta-actions {
  display: flex;
  gap: 10px;
  flex-shrink: 0;
  flex-wrap: wrap;
}

/* Main footer grid */
.footer-main {
  padding: 48px 0 40px;
}
.footer-grid {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
  gap: var(--space-6);
}

/* Brand column */
.footer-brand {}

.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-weight: 700;
  font-size: 1rem;
  color: var(--text-bright);
  text-decoration: none;
  margin-bottom: var(--space-3);
}
.footer-logo:hover { text-decoration: none; color: var(--text-bright); }

.footer-tagline {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: var(--space-4);
  max-width: 220px;
}

.footer-version {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}
.footer-version-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  background: var(--accent-dim);
  color: var(--accent);
  font-size: 0.68rem;
  font-weight: 600;
}
.footer-version-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-dim);
}

.footer-social {
  display: flex;
  gap: 6px;
}
.footer-social-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  color: var(--text-dim);
  transition: color 0.2s, border-color 0.2s, background 0.2s;
  text-decoration: none;
}
.footer-social-btn:hover { color: var(--text); border-color: var(--border-light); background: var(--bg-card); text-decoration: none; }
.footer-social-btn--discord:hover { color: #7289da; border-color: rgba(114, 137, 218, 0.4); }
.footer-social-btn--kofi:hover { color: #ff5e5b; border-color: rgba(255, 94, 91, 0.4); }

/* Link columns */
.footer-col {}

.footer-col-title {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 14px;
}

.footer-col-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.footer-col-links a {
  font-size: 0.82rem;
  color: var(--text-dim);
  transition: color 0.2s;
  text-decoration: none;
}
.footer-col-links a:hover { color: var(--accent); text-decoration: none; }

/* Product links with dot indicator */
.footer-link-product {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.footer-product-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}
.footer-product-dot--vox { background: var(--violet); }
.footer-product-dot--icm { background: var(--cyan); }
.footer-product-dot--cloud { background: var(--accent); opacity: 0.4; }

.footer-badge-soon {
  display: inline-block;
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  border: 1px solid var(--border);
  font-size: 0.62rem;
  font-weight: 600;
  color: var(--text-dim);
  margin-left: 4px;
}

/* Bottom bar */
.footer-bottom {
  border-top: 1px solid var(--border);
  padding: 20px 0;
}
.footer-bottom-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.footer-bottom-left,
.footer-bottom-right {
  font-size: 0.75rem;
  color: var(--text-dim);
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
.footer-bottom-left a,
.footer-bottom-right a {
  color: var(--text-dim);
  transition: color 0.2s;
  text-decoration: none;
}
.footer-bottom-left a:hover,
.footer-bottom-right a:hover { color: var(--accent); }
.footer-bottom-sep { color: var(--border-light); }
.footer-copyright { color: var(--text-dim); }

/* Footer responsive */
@media (max-width: 1024px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 28px;
  }
  .footer-brand { grid-column: 1 / -1; display: flex; flex-direction: row; gap: var(--space-5); flex-wrap: wrap; align-items: flex-start; }
  .footer-tagline { max-width: 300px; }
}
@media (max-width: 768px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .footer-brand { flex-direction: column; }
  .footer-cta-inner { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 480px) {
  .footer-grid { grid-template-columns: 1fr; }
  .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
}
</style>
