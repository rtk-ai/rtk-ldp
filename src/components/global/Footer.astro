---
/**
 * Footer.astro — compact footer for the docs (Starlight override).
 *
 * Deliberately NOT the full FooterV3 site map: docs pages are reference
 * material and a marketing footer under every page would fight the content.
 * Styling follows the V3 system so it still reads as the same site.
 */
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-logo">RTK</span>
      <span class="footer-copy">© {year} RTK AI. All rights reserved.</span>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/guide/" class="footer-link">Docs</a>
      <a href="/team/" class="footer-link">Team</a>
      <a href="https://github.com/rtk-ai/rtk" class="footer-link" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(148, 163, 184, 0.14); /* --lp3-line, outside .lp3 scope */
    background: var(--bg);
    padding: 1.5rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* quiet wordmark — the V3 chrome keeps colour for the accent and the CTA */
  .footer-logo {
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--text-bright);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .footer-nav {
    display: flex;
    gap: 1rem;
  }

  .footer-link {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .footer-link:hover {
    color: var(--text-bright);
    text-decoration: none;
  }
</style>
