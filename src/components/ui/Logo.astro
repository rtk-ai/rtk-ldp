---
interface Props {
  size?: number
  showText?: boolean
  class?: string
}
const { size = 28, showText = true, class: cls } = Astro.props
---
<a href="/" class:list={['logo-link', cls]}>
  <img src="/brand/logo.png" alt="rtk logo" width={size} height={size} style={`border-radius:var(--radius-sm);`} />
  {showText && <span class="logo-text">rtk</span>}
</a>

<style>
.logo-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  text-decoration: none;
  color: var(--text);
  font-weight: 700;
  font-size: var(--text-base);
}
.logo-link:hover { text-decoration: none; }
.logo-text { letter-spacing: -0.02em; }
</style>
