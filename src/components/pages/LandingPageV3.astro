---
import type { Lang } from '../../lib/i18n'
import Layout from '../../layouts/Layout.astro'
import NavV3 from '../landing/v3/NavV3.astro'
import HeroV3 from '../landing/v3/HeroV3.astro'
import Companies from '../landing/v3/Companies.astro'
import Ecosystem from '../landing/v3/Ecosystem.astro'
import ProblemV3 from '../landing/v3/ProblemV3.astro'
import ProofV3 from '../landing/v3/ProofV3.astro'
import CompressorV3 from '../landing/v3/CompressorV3.astro'
import EngineV3 from '../landing/v3/EngineV3.astro'
import PipelineV3 from '../landing/v3/PipelineV3.astro'
import InstallV3 from '../landing/v3/InstallV3.astro'
import FaqV3 from '../landing/v3/FaqV3.astro'
import FinalCta from '../landing/v3/FinalCta.astro'
import ProCta from '../landing/v3/ProCta.astro'
import FooterV3 from '../landing/v3/FooterV3.astro'
import { getRepoFacts } from '../../lib/github'
import SearchModal from '../global/SearchModal.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props

const faqItems = [
  {
    q: 'What is RTK (Rust Token Killer)?',
    a: 'RTK is a cost reduction engine for AI coding agents. It cleans what your agent reads at every tool call — shell output, file reads, search results, web pages, MCP calls — cutting up to 90% of command output noise, and it can hand heavy work to cheaper models. The battle-tested Bash compressor developers starred is the core of the engine. RTK is free to use, written in Rust, with the CLI open source under Apache 2.0, and works with Claude Code, Cursor, and 18 AI coding agents.',
  },
  {
    q: "What is RTK Engine?",
    a: "RTK Engine turns the battle-tested compressor into a full cost reduction engine. RTK can now compress every tool's output, not just shell commands, route heavy work to cheaper models, and let you build your own pipeline, plug in new methods, and share your setup as one file that works in any supported agent. Upgrading changes nothing: RTK works exactly as before until you add a line.",
    links: [{ href: '/blog/rtk-v1-release/', label: 'Read the RTK Engine announcement' }],
  },
  {
    q: 'What is a pipeline?',
    a: "One file of rules. Each rule reads like a sentence: where RTK acts, when, and what it does — for example, when the agent reads a file longer than 350 lines, send it to a cheaper model. RTK's own behaviour is written in the same format, so you never start from a blank page: pick a built-in pipeline, change one line, or write your own.",
  },
  {
    q: 'Can I share a pipeline with my team?',
    a: 'Yes. A pipeline is one file: share it, drop it in, and it works in any supported agent. The same file can be used in Claude Code by one person and Cursor by another.',
  },
  {
    q: 'Do I need to change anything when I upgrade to RTK Engine?',
    a: 'No. Install, run rtk init, and RTK works exactly as before. Nothing changes until you add a line to a pipeline. The compressor you already rely on is the core of the engine, not a feature that moved.',
  },
  {
    q: 'How many tokens does RTK actually save?',
    a: 'On the commands RTK rewrites, output drops by 56% on average, and by up to 90% on the noisiest ones. Across the community that adds up to billions of tokens saved. The exact figure depends on the command, so the benchmarks page publishes the methodology and the per-command results, and the blog covers what independent studies measured, including the cases where RTK did not come out ahead. For your own numbers, run rtk gain after a few days of use.',
    links: [
      { href: '/benchmarks/', label: 'See the benchmarks' },
      { href: '/blog/', label: 'Read the analysis' },
    ],
  },
  {
    q: 'Is RTK free? Are there usage limits?',
    a: 'RTK is completely free. It is open source under the Apache 2.0 license, with source code available on GitHub at github.com/rtk-ai/rtk. There are no usage limits, no API keys required and no accounts. Routing to a cheaper model is optional and uses a model key you provide. Telemetry is opt-in: it is off until you explicitly enable it, and it collects no personal data. For teams, RTK Pro is available at pro.rtk-ai.app.',
  },
  {
    q: 'Which AI coding tools and commands does RTK support?',
    a: 'RTK works with 18 AI coding agents, including Claude Code (Anthropic), Cursor, GitHub Copilot, Codex, Gemini CLI, Windsurf, Cline and Aider — and the engine acts on every tool an agent uses: shell commands, file reads, search, web fetches and MCP calls. On the shell side it covers 125+ commands: cargo test, pytest, go test, git diff, git status, git log, grep, find, ls, pnpm list, tsc, eslint, prisma, docker, kubectl, and more.',
  },
  {
    q: 'How does RTK work without changing my workflow?',
    a: 'Running rtk init --global installs hooks inside your agent that act around each tool call: shell commands are automatically rewritten to rtk equivalents, and output is compressed before it enters the context window. If you turn it on, the RTK Proxy also acts on the API traffic, trimming what the agent sends to the model. You continue using your normal commands, with no manual changes to prompts or workflows needed.',
  },
  {
    q: 'Does RTK affect code quality or AI reasoning accuracy?',
    a: 'No. RTK removes verbose boilerplate and repetitive output noise, not meaningful content. Test failures, error messages, diffs, and stack traces are preserved in full. The AI receives the same essential information with far less noise around it, which leaves more of the context window for reasoning.',
  },
]

const { version, starsLabel } = await getRepoFacts()


const buildDate = new Date().toISOString().split('T')[0]

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.rtk-ai.app/#organization',
      name: 'RTK AI',
      url: 'https://www.rtk-ai.app',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.rtk-ai.app/brand/logo.png',
      },
      sameAs: [
        'https://github.com/rtk-ai',
        'https://discord.gg/RySmvNF5kF',
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://www.rtk-ai.app/#software',
      name: 'RTK — Rust Token Killer',
      description:
        'RTK is a cost reduction engine for AI coding agents: it compresses what the agent reads at every tool call, cutting up to 90% of command output noise with zero config changes, and can route heavy work to cheaper models through a pipeline you control and share as one file. Free to use, CLI open source under Apache 2.0, written in Rust.',
      url: 'https://www.rtk-ai.app',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      ...(version ? { softwareVersion: version } : {}),
      releaseNotes: 'https://github.com/rtk-ai/rtk/blob/master/CHANGELOG.md',
      datePublished: '2025-01-01',
      dateModified: buildDate,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      license: 'https://opensource.org/licenses/Apache-2.0',
      downloadUrl: 'https://github.com/rtk-ai/rtk',
      author: { '@id': 'https://www.rtk-ai.app/#organization' },
      featureList: [
        '56% average output reduction on the commands RTK rewrites, benchmarks published in full',
        '3x longer AI coding sessions by reducing context pollution',
        'Compresses the output of every tool an agent uses: shell, file reads, search, web, MCP',
        'Routes heavy work to cheaper models via pipeline rules',
        'Pipelines: one file of rules you build, plug methods into, and share with your team',
        'Works with 18 AI coding agents, including Claude Code, Cursor and Gemini CLI',
        'Supports 125+ CLI commands: cargo test, git status, grep, find, ls, docker, kubectl, and more',
        'Auto-rewrite hook for Claude Code via PreToolUse',
        'Real-time analytics dashboard with rtk gain',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://www.rtk-ai.app/#faq',
      mainEntity: faqItems.map(({ q, a, links }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: links?.length
            ? `${a} ${links.map(l => `<a href="https://www.rtk-ai.app${l.href}">${l.label}</a>`).join(' ')}`
            : a,
        },
      })),
    },
    {
      '@type': 'HowTo',
      '@id': 'https://www.rtk-ai.app/#howto-install',
      name: 'How to install RTK and cut up to 90% of CLI output noise',
      description:
        'Install RTK (Rust Token Killer) in under 2 minutes and activate the automatic command compression hook. No workflow changes required.',
      totalTime: 'PT2M',
      estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
      tool: [{ '@type': 'HowToTool', name: 'Terminal / Command Line' }],
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Install RTK',
          text: 'Run the one-liner installer: curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh — supports macOS and Linux. Alternatively install via Homebrew: brew install rtk-ai/tap/rtk.',
          url: 'https://www.rtk-ai.app/#install',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Activate the auto-rewrite hook',
          text: 'Run rtk init --global to install the PreToolUse hook in Claude Code. This transparently rewrites Bash tool calls to rtk equivalents, compressing output before it reaches the context window.',
          url: 'https://www.rtk-ai.app/#install',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Verify your token savings',
          text: 'Run rtk gain to open the analytics dashboard. View total tokens saved, per-command savings percentages, and daily/weekly/monthly trends.',
          url: 'https://www.rtk-ai.app/#install',
        },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://www.rtk-ai.app/#webpage',
      url: 'https://www.rtk-ai.app/',
      name: 'RTK — Rust Token Killer',
      description: 'RTK is a cost reduction engine for AI coding agents: it cuts command output noise before it reaches your AI context — 56% less on average for rewritten commands, up to 90% on the noisiest — routes heavy work to cheaper models, and lets you build and share pipelines. Free to use, CLI open source, Apache 2.0, written in Rust.',
      inLanguage: 'en',
      dateModified: buildDate,
      isPartOf: { '@type': 'WebSite', name: 'RTK', url: 'https://www.rtk-ai.app' },
      publisher: { '@id': 'https://www.rtk-ai.app/#organization' },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.faq-answer'],
      },
    },
  ],
}
---
<Layout
  title="RTK — Rust Token Killer"
  description="RTK Engine cuts what AI coding agents cost: compress tool output, route work to cheaper models, share one pipeline file. Zero config, Apache 2.0."
  schemaOrg={schemaOrg}
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Geist:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      ;(function () {
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual'
          var entry = performance.getEntriesByType && performance.getEntriesByType('navigation')[0]
          var revisit = entry && (entry.type === 'reload' || entry.type === 'back_forward')
          if (location.hash && !revisit) return
          if (location.hash && revisit) {
            history.replaceState(null, '', location.pathname + location.search)
          }
          window.scrollTo(0, 0)
          window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.scrollTo(0, 0)
          })
        } catch (e) {}
        try {
          if (
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
            window.innerHeight > 560
          ) {
            document.documentElement.classList.add('lp3-boot')
          }
        } catch (e) {}
      })()
    </script>
  </Fragment>

  <div class="lp3">
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <NavV3 starsLabel={starsLabel} lang={lang} promo />
    <main id="main-content">
      <HeroV3 starsLabel={starsLabel} lang={lang} />
      <Companies lang={lang} />
      <ProblemV3 lang={lang} />
      <CompressorV3 lang={lang} />
      <EngineV3 lang={lang} />
      <PipelineV3 lang={lang} />
      <ProofV3 lang={lang} />
      <Ecosystem lang={lang} />
      <section class="lp3-section lp3-benefit" id="why">
        <div class="lp3-container">
          <p class="lp3-h2 lp3-benefit-line reveal">Fewer tokens. Lower bill. <em>Same answers.</em></p>
        </div>
      </section>
      <InstallV3 lang={lang} />
      <FaqV3 items={faqItems} lang={lang} />
      <FinalCta lang={lang} />
      <ProCta lang={lang} />
    </main>
    <FooterV3 lang={lang} compact />
    <SearchModal />
  </div>
</Layout>

<style is:global>
  @import '../../styles/landing-v3.css';
</style>

<script>
  import { initReveal } from '../../scripts/reveal'
  import { initCopyButtons } from '../../scripts/copy'
  import {
    initFooterGroups,
    initHeroProofPlacement,
    initHeroScroll,
    initHeroIdle,
    initIntroCue,
    initLayerCosts,
    initCountUp,
    initButtonSheen,
    initMarquee,
    initEcoMore,
    initHookTabs,
  } from '../../scripts/landing-v3'

  initReveal()
  initCopyButtons()
  initFooterGroups()
  initHeroProofPlacement()
  initHeroScroll()
  initHeroIdle()
  initIntroCue()
  initLayerCosts()
  initCountUp()
  initButtonSheen()
  initMarquee()
  initEcoMore()
  initHookTabs()
</script>
