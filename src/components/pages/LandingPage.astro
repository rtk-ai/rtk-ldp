---
import type { Lang } from '../../lib/i18n'
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../global/SiteHeader.astro'
import Hero from '../landing/Hero.astro'
import Problem from '../landing/Problem.astro'
import DemoSlideshow from '../landing/DemoSlideshow.astro'
import Install from '../landing/Install.astro'
import Cta from '../landing/Cta.astro'
import SiteFooter from '../global/SiteFooter.astro'
import SearchModal from '../global/SearchModal.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props


let version = ''
try {
  const headers: Record<string, string> = { 'User-Agent': 'rtk-landing' }
  const token = process.env.GITHUB_TOKEN
  if (token) headers['Authorization'] = `Bearer ${token}`
  const rel = await fetch('https://api.github.com/repos/rtk-ai/rtk/releases/latest', { headers })
  if (rel.ok) {
    const data = await rel.json()
    if (data.tag_name) version = data.tag_name.replace(/^v/, '')
  }
} catch {}

const buildDate = new Date().toISOString().split('T')[0]

// Single @graph block — links all entities, preferred by Google & AI search engines
const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.rtk-ai.app/#organization',
      name: 'RTK AI',
      url: 'https://www.rtk-ai.app',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.rtk-ai.app/favicon.svg',
      },
      sameAs: [
        'https://github.com/rtk-ai',
        'https://discord.gg/RySmvNF5kF',
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://www.rtk-ai.app/#software',
      name: 'RTK — Rust Token Killer',
      description:
        'RTK compresses CLI command outputs before they reach the AI context window, reducing token output by 60-90% with zero config changes. Open source, Apache 2.0 licensed, written in Rust.',
      url: 'https://www.rtk-ai.app',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      ...(version ? { softwareVersion: version } : {}),
      releaseNotes: 'https://github.com/rtk-ai/rtk/blob/master/CHANGELOG.md',
      datePublished: '2025-01-01',
      dateModified: buildDate,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      downloadUrl: 'https://github.com/rtk-ai/rtk',
      author: { '@id': 'https://www.rtk-ai.app/#organization' },
      featureList: [
        '89% average CLI token noise removed — measured across 2,900+ real commands',
        '3x longer AI coding sessions by reducing context pollution',
        'Supports all major CLI commands: cargo test, git status, grep, find, ls, docker, kubectl, and more',
        'Auto-rewrite hook for Claude Code via PreToolUse',
        'Real-time analytics dashboard with rtk gain',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://www.rtk-ai.app/faq/',
      url: 'https://www.rtk-ai.app/faq/',
    },
    {
      '@type': 'HowTo',
      '@id': 'https://www.rtk-ai.app/#howto-install',
      name: 'How to install RTK and reduce AI coding token usage by 60-90%',
      description:
        'Install RTK (Rust Token Killer) in under 2 minutes and activate the automatic command compression hook. No workflow changes required.',
      totalTime: 'PT2M',
      estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
      tool: [{ '@type': 'HowToTool', name: 'Terminal / Command Line' }],
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Install RTK',
          text: 'Run the one-liner installer: curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh — supports macOS and Linux. Alternatively install via Homebrew: brew install rtk.',
          url: 'https://www.rtk-ai.app/#install',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Activate the auto-rewrite hook',
          text: 'Run rtk init --global for Claude Code and most AI tools (installs a PreToolUse hook that transparently rewrites commands to rtk equivalents). For Cursor, use rtk init --global --cursor. Your existing workflow stays unchanged; RTK intercepts commands and compresses output before it reaches the context window.',
          url: 'https://www.rtk-ai.app/#install',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Verify your token savings',
          text: 'Run rtk gain to open the analytics dashboard. View total tokens saved, per-command savings percentages, and daily/weekly/monthly trends.',
          url: 'https://www.rtk-ai.app/#install',
        },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://www.rtk-ai.app/#webpage',
      url: 'https://www.rtk-ai.app/',
      name: 'RTK — Rust Token Killer',
      description: 'RTK reduces CLI output noise by 60-90% before it reaches the AI context window — measured across 2,900+ real commands. 89% avg noise removed, 3x longer sessions, zero config. Free, open source, Apache 2.0, written in Rust.',
      inLanguage: 'en',
      dateModified: buildDate,
      isPartOf: { '@type': 'WebSite', name: 'RTK', url: 'https://www.rtk-ai.app' },
      publisher: { '@id': 'https://www.rtk-ai.app/#organization' },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.hero-context', '.session-note', '.problem-intro'],
      },
    },
  ],
}
---
<Layout
  title="RTK — Rust Token Killer"
  description="RTK reduces CLI output noise by 60-90% before it hits the AI context window — measured across 2,900+ real commands. 89% avg noise removed, 3x longer sessions, zero config. Apache 2.0."
  schemaOrg={schemaOrg}
>
  <a href="#main-content" class="skip-to-content">Skip to content</a>
  <SiteHeader lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Problem lang={lang} />
    <DemoSlideshow lang={lang} />
    <Install lang={lang} />
    <Cta lang={lang} />

  </main>

  <SiteFooter />
  <SearchModal />
</Layout>

<style is:global>
  @import '../../styles/landing.css';
</style>

<script>
  import { initCopyButtons } from '../../scripts/copy'
  import { initSlideshow } from '../../scripts/slideshow'

  initCopyButtons()
  initSlideshow()
</script>
