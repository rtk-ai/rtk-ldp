---
/**
 * RtkMark — the V3 Norse-geometry brand mark.
 * Elongated hexagon + angular rune stem. Thin strokes, inherits currentColor.
 * Recurring anchor: nav, hero gate, solution diagram, final CTA, footer.
 */
interface Props {
  size?: number
  strokeWidth?: number
  class?: string
}
const { size = 32, strokeWidth = 2, class: className } = Astro.props
const h = size
const w = Math.round(size * 0.75)
---
<svg
  class={className}
  width={w}
  height={h}
  viewBox="0 0 48 64"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linejoin="miter"
  stroke-linecap="butt"
  aria-hidden="true"
>
  <!-- outer elongated hexagon -->
  <path d="M24 2 L46 16 L46 48 L24 62 L2 48 L2 16 Z" />
  <!-- angular rune stem (Bjarkan-inspired) -->
  <path d="M19 14 L19 50" />
  <path d="M19 14 L32 22 L19 31" />
  <path d="M19 31 L32 39 L19 47" />
</svg>
