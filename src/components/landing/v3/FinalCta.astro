---
/**
 * 08 / SHIP IT — closing CTA.
 *
 * The install commands live in InstallV3 (which owns id="install"); this
 * section closes the story and carries the share row restored from the
 * previous design's Cta.astro.
 *
 * Share targets are the product page, not the GitHub repo: a share should land
 * someone on rtk-ai.app, and LinkedIn scrapes that URL for the card preview.
 */
import { t, type Lang } from '../../../lib/i18n'

interface Props {
  lang?: Lang
}
const { lang = 'en' } = Astro.props

const SITE = 'https://www.rtk-ai.app'
const shareX =
  'https://x.com/intent/tweet?text=' + encodeURIComponent('rtk: your AI coding agent is drowning in CLI noise. RTK strips the noise out of them. Better reasoning, longer sessions, lower costs. Open source, Rust.') + '&url=' + encodeURIComponent(SITE)
const shareBsky =
  'https://bsky.app/intent/compose?text=' + encodeURIComponent('rtk: your AI coding agent is drowning in CLI noise. RTK strips the noise out of them. Open source, Rust. https://www.rtk-ai.app')
const shareLi = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(SITE)
---
<section class="lp3-section lp3-cta" id="ship">
  <div class="lp3-cta-watermark" aria-hidden="true">
    <img src="/brand/box-logo-white.webp" alt="" width="460" height="460" loading="lazy" decoding="async" />
  </div>
  <div class="lp3-container">
    <h2 class="lp3-cta-title reveal" set:html={t('v3.cta.title', lang)}></h2>
    <p class="lp3-cta-sub reveal">{t('v3.cta.sub', lang)}</p>

    <div class="lp3-cta-buttons reveal">
      <a href="/#install" class="lp3-btn lp3-btn-primary">
        {t('v3.hero.cta_install', lang)} <span class="arr" aria-hidden="true">→</span>
      </a>
      <a href="https://github.com/rtk-ai/rtk" class="lp3-btn lp3-btn-ghost" target="_blank" rel="noopener">
        {t('v3.hero.cta_github', lang)} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="lp3-cta-share reveal">
      <span>{t('v3.cta.share', lang)}</span>
      <a href={shareX} target="_blank" rel="noopener nofollow" aria-label="Share on X">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.1 8.1L23 22h-6.6l-5.2-6.8L5.3 22H2.2l7.6-8.7L1.7 2h6.8l4.7 6.2zm-1.2 18h1.8L7.4 3.8H5.5z"/></svg>
      </a>
      <a href={shareBsky} target="_blank" rel="noopener nofollow" aria-label="Share on Bluesky">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 10.8C10.9 8.6 7.9 4.6 5.2 2.7 2.6.9 1.6 1.2 1 1.5.2 1.9 0 3.1 0 3.8s.4 5.9.6 6.8c.7 2.8 3.6 3.8 6.3 3.5h.4-.4c-4 .6-7.5 2-2.9 7.2 5.1 5.3 7-1.1 8-4.3 1 3.2 2.1 9.4 7.9 4.3 4.3-4.3 1.2-6.6-2.8-7.2h-.4.4c2.7.3 5.6-.7 6.3-3.5.2-.9.6-6.1.6-6.8s-.2-1.9-1-2.3c-.6-.3-1.6-.6-4.2 1.2C16.1 4.6 13.1 8.6 12 10.8"/></svg>
      </a>
      <a href={shareLi} target="_blank" rel="noopener nofollow" aria-label="Share on LinkedIn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5M2.5 9.5h5V21h-5zM9.5 9.5h4.8v1.6c.7-1.2 2.2-1.9 3.9-1.9 3.1 0 4.3 1.9 4.3 5.3V21h-5v-5.6c0-1.5-.5-2.4-1.8-2.4-1.1 0-1.7.7-2 1.5-.1.2-.1.6-.1.9V21h-5z"/></svg>
      </a>
    </div>
  </div>
</section>
