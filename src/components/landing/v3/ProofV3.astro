---
import IconDiscord from '../../ui/icons/IconDiscord.astro'
import { t, type Lang } from '../../../lib/i18n'

interface Props {
  lang?: Lang
}
const { lang = 'en' } = Astro.props

const agents = ['Claude Code', 'Cursor', 'Codex']
---
<section class="lp3-section" id="proof">
  <div class="lp3-container">
    <p class="lp3-eyebrow reveal"><span class="idx">05</span> / {t('v3.proof.eyebrow', lang)}</p>
    <h2 class="lp3-h2 reveal" set:html={t('v3.proof.title', lang)}></h2>
    <p class="lp3-proof-sub reveal" set:html={t('v3.proof.sub', lang)}></p>

    <div class="lp3-share reveal">
      <p class="lp3-sr">{t('v3.proof.ill_sr', lang)}</p>

      <div class="lp3-share-term" aria-hidden="true">
        <span><i>$</i> rtk pipeline share</span>
        <span class="ok">✓ {t('v3.proof.s_copied', lang)}</span>
      </div>

      <div class="lp3-share-card" aria-hidden="true">
        <div class="lp3-share-top">
          <img src="/brand/box-logo-white.webp" alt="" width="22" height="22" loading="lazy" decoding="async" />
          <span class="name">team-pipeline</span>
          <span class="badge">{t('v3.proof.s_public', lang)}</span>
        </div>

        <div class="lp3-share-stats">
          <div><b>4.7M</b><span>{t('v3.proof.g_saved', lang)}</span></div>
          <div><b class="acc">−44%</b><span>{t('v3.proof.g_less', lang)}</span></div>
        </div>

        <svg class="lp3-share-spark" viewBox="0 0 400 64" preserveAspectRatio="none">
          <defs>
            <linearGradient id="lp3SparkFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="currentColor" stop-opacity="0.22" />
              <stop offset="1" stop-color="currentColor" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path class="fill" d="M0 58 C40 56 70 52 100 47 S160 40 200 33 S280 22 320 15 S380 6 400 4 L400 64 L0 64 Z" fill="url(#lp3SparkFill)" />
          <path class="line" d="M0 58 C40 56 70 52 100 47 S160 40 200 33 S280 22 320 15 S380 6 400 4" pathLength="1" />
        </svg>

        <div class="lp3-share-runs">
          <span class="k">{t('v3.proof.s_runs', lang)}</span>
          {agents.map(a => <span class="chip">{a}</span>)}
          <span class="chip">+15</span>
        </div>
      </div>
    </div>

    <a
      class="lp3-proof-discord reveal"
      href="https://discord.gg/RySmvNF5kF"
      target="_blank"
      rel="noopener"
    >
      <IconDiscord size={16} />
      <span set:html={t('v3.proof.discord', lang)}></span>
      <span class="arr" aria-hidden="true">↗</span>
    </a>
  </div>
</section>
