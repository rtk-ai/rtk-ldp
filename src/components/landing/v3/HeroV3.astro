---
/**
 * HeroV3 — the cinematic landing choreography:
 *
 *   1. On load the transformation visual fills the screen, alone (big-screen act).
 *   2. Scroll plays it at full size: noise floods in → the gate lights → the
 *      clean context appears.
 *   3. Keep scrolling: the illustration shrinks and docks into its slot on the
 *      right, the title + CTAs slide in on the left, and the proof numbers
 *      (downloads, stars…) count up along the bottom. The hero assembles itself.
 *
 * Default (no JS / reduced motion / mobile): renders the final assembled state.
 * landing-v3.ts adds `.js-anim` and drives every phase from scroll progress.
 */
import { t, type Lang } from '../../../lib/i18n'

interface Props {
  starsLabel: string
  lang?: Lang
}
const { starsLabel, lang = 'en' } = Astro.props

// Commands: 64 cmd implementations (src/cmds/) + 63 toml filters
// (src/filters/) counted in the rtk repo → 127 handlers.
const stats = [
  { num: '1.6M+', label: t('v3.hero.stat_downloads', lang) },
  { num: `${starsLabel}+`, label: t('v3.hero.stat_stars', lang) },
  { num: '140K+', label: t('v3.hero.stat_devs', lang) },
  { num: '125+', label: t('v3.hero.stat_commands', lang) },
  { num: '17', label: t('v3.hero.stat_tools', lang) },
]

// The context window as a TOKEN GRID (20×20 fine cells per panel).
// The story is BINARY and legible: a near-uniform muted RED noise mass, with a
// few mint signal tokens. Scroll plays the red→green arc — the red collapses
// under the filter, the mint survives. No tonal zoo — clarity over texture.
//
//   t: appear threshold. The raw window STAYS FULL once written — it is the
//   raw input; the filtering story lives in the contrast with the clean panel.
const COLS = 20
const ROWS = 24 // cells are true squares; the grid clips flush at the panel edge
const rawCells = Array.from({ length: COLS * ROWS }, (_, i) => {
  // Knuth multiplicative hash — survivors scatter at ANY column count
  // (a linear hash formed diagonals when the mobile grid reflowed to 28 cols)
  const keep = ((i * 2654435761) >>> 0) % 100 < 4
  const spread = ((i * 53) % 40) / 40
  const a = keep ? 0.6 + spread * 0.2 : 0.18 + spread * 0.14
  // fills LIKE TEXT: strict reading order (row-major index = left→right,
  // top→bottom), completing fast in the first ~18% of the transformation
  const t = +((i / (COLS * ROWS)) * 0.18).toFixed(3)
  const fd = `-${((i % 9) * 0.5).toFixed(2)}s`
  return { keep, a: +a.toFixed(2), t, fd }
})

// CLEAN: the same grid as a faint dot matrix of free capacity. The mint tokens
// that materialize are THE SAME survivors, at the SAME grid positions as in the
// raw panel — they visibly pass through the gate, and they arrive in the same
// text-like reading order the raw window filled with.
const survivorIdx = rawCells.flatMap((c, i) => (c.keep ? [i] : []))
const cleanFilledAt = new Map<number, number>(
  survivorIdx.map((idx, rank) => [
    idx,
    +(0.5 + (rank * 0.22) / Math.max(survivorIdx.length - 1, 1)).toFixed(3),
  ])
)
const cleanCells = Array.from({ length: COLS * ROWS }, (_, i) => ({
  t: cleanFilledAt.get(i),
}))

// Ambient motes — dust drifting through the light. Deterministic pseudo-random.
const motes = Array.from({ length: 14 }, (_, i) => ({
  x: (i * 7.3 + 5) % 96,
  y: 12 + ((i * 13.7 + 9) % 76),
  s: i % 3 === 0 ? 3 : 2,
  d: 9 + (i % 5) * 2.6,
  dl: -((i * 1.9) % 12),
}))

// Light strands sweeping through the gate (viewBox 0 0 1000 560, gate at 500,280).
// Deterministic pseudo-variation from the index — no randomness at build time.
const strandsIn = Array.from({ length: 12 }, (_, i) => {
  const y = 36 + i * 44
  const x0 = 8 + (i % 4) * 30
  const yc = 258 + (i % 5) * 11
  const c1 = 320 + (i % 3) * 46
  const c2 = 408 + (i % 4) * 20
  return `M ${x0} ${y} C ${c1} ${y}, ${c2} ${yc}, 490 ${yc}`
})
const strandsOut = Array.from({ length: 9 }, (_, i) => {
  const y = 64 + i * 54
  const yc = 262 + (i % 4) * 10
  const c1 = 596 + (i % 4) * 18
  const c2 = 664 + (i % 3) * 44
  const x1 = 992 - (i % 3) * 26
  return `M 510 ${yc} C ${c1} ${yc}, ${c2} ${y}, ${x1} ${y}`
})

// Vertical strand variant for the mobile stack (RAW ↓ gate ↓ CLEAN):
// viewBox 0 0 600 1000, gate at (300, 500). Same behind-the-panels behavior —
// the links show in the gaps and meet at the gate.
// Convergence knot: tight and SYMMETRIC around x=284 (the mark's optical
// center — the mark is nudged slightly left on mobile to balance its label).
const strandsInV = Array.from({ length: 10 }, (_, i) => {
  const x = 30 + i * 60
  const y0 = 6 + (i % 4) * 22
  const xc = 296 + ((i % 5) - 2) * 8
  const c1 = 316 + (i % 3) * 42
  const c2 = 406 + (i % 4) * 20
  return `M ${x} ${y0} C ${x} ${c1}, ${xc} ${c2}, ${xc} 492`
})
const strandsOutV = Array.from({ length: 8 }, (_, i) => {
  const x = 58 + i * 72
  const xc = 296 + ((i % 4) - 1.5) * 8
  const c1 = 594 + (i % 4) * 18
  const c2 = 662 + (i % 3) * 42
  const y1 = 992 - (i % 3) * 22
  return `M ${xc} 508 C ${xc} ${c1}, ${x} ${c2}, ${x} ${y1}`
})
---
<section class="lp3-hero" id="hero" data-hero>
  <div class="lp3-hero-pin" data-pin>
    <div class="lp3-hero-stage">
      <div class="lp3-hero-atmo" aria-hidden="true"></div>

      <!-- Act 0 — title card: hook + scroll cue around the gate mark, which is
           scaled up to logo size at landing and travels into its slot on scroll
           (ONE element — the spacer only reserves its screen spot).
           Only exists in the animated choreography (display:none otherwise). -->
      <div class="lp3-intro" data-intro>
        <div class="lp3-intro-spacer" data-intro-spacer aria-hidden="true"></div>
        <p class="lp3-intro-name">RTK</p>
        <p class="lp3-intro-tag" set:html={t('v3.hero.intro_tag', lang)}></p>
        <p class="lp3-intro-cue">
          <span class="ring" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m6 13 6 6 6-6"/></svg>
          </span>
          {t('v3.hero.scroll_cue', lang)}
        </p>
      </div>

      <div class="lp3-motes" aria-hidden="true">
        {motes.map(m => (
          <i style={`--x:${m.x}%; --y:${m.y}%; --s:${m.s}px; --d:${m.d}s; --dl:${m.dl}s`}></i>
        ))}
      </div>
      <div class="lp3-container lp3-hero-grid">

        <div class="lp3-hero-copy">
          <!-- Pro chip — the story's epilogue: last element to appear -->
          <a
            href="https://pro.rtk-ai.app"
            class="lp3-pro-chip"
            target="_blank"
            rel="noopener"
          >
            <span class="dot" aria-hidden="true"></span>
            <span class="txt" set:html={t('v3.hero.pro_chip', lang)}></span>
            <span class="arr" aria-hidden="true">→</span>
          </a>
          <h1 class="lp3-hero-title" set:html={t('v3.hero.title', lang)}></h1>
          <div class="lp3-hero-cta">
            <a href="/#install" class="lp3-btn lp3-btn-primary">
              {t('v3.hero.cta_install', lang)} <span class="arr" aria-hidden="true">→</span>
            </a>
            <a href="https://github.com/rtk-ai/rtk" class="lp3-btn lp3-btn-ghost" target="_blank" rel="noopener">
              {t('v3.hero.cta_github', lang)} <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="lp3-hero-meta">{t('v3.hero.meta', lang)}</p>
        </div>

        <div class="lp3-hero-visual">
          <p class="lp3-sr">
            {t('v3.hero.visual_sr', lang)}
          </p>
          <div class="lp3-flow" aria-hidden="true">

            <svg class="lp3-strands" viewBox="0 0 1000 560" preserveAspectRatio="none">
              <defs>
                <linearGradient id="lp3gIn" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-opacity="0" />
                  <stop offset="0.55" stop-opacity="0.14" />
                  <stop offset="1" stop-opacity="0.6" />
                </linearGradient>
                <linearGradient id="lp3gOut" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-opacity="0.6" />
                  <stop offset="0.45" stop-opacity="0.14" />
                  <stop offset="1" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g data-flow-in stroke="url(#lp3gIn)">
                {strandsIn.map(d => <path d={d} />)}
              </g>
              <g data-flow-out stroke="url(#lp3gOut)">
                {strandsOut.map(d => <path d={d} />)}
              </g>
            </svg>

            <svg class="lp3-strands vertical" viewBox="0 0 600 1000" preserveAspectRatio="none">
              <defs>
                <linearGradient id="lp3gInV" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-opacity="0" />
                  <stop offset="0.55" stop-opacity="0.14" />
                  <stop offset="1" stop-opacity="0.6" />
                </linearGradient>
                <linearGradient id="lp3gOutV" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-opacity="0.6" />
                  <stop offset="0.45" stop-opacity="0.14" />
                  <stop offset="1" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g data-flow-in stroke="url(#lp3gInV)">
                {strandsInV.map(d => <path d={d} />)}
              </g>
              <g data-flow-out stroke="url(#lp3gOutV)">
                {strandsOutV.map(d => <path d={d} />)}
              </g>
            </svg>

            <div class="lp3-panel lp3-panel-raw">
              <div class="lp3-panel-head">
                <span><i class="dot"></i>{t('v3.hero.panel_raw', lang)}</span>
                <span class="pct" data-raw-pct>86% used</span>
              </div>
              <div class="lp3-panel-body">
                {rawCells.map(c => (
                  <i
                    class={`lp3-cell ${c.keep ? 't-keep' : 't-dim'}`}
                    style={`--a:${c.a}; --fd:${c.fd}`}
                    data-t={c.t}
                  ></i>
                ))}
              </div>
              <div class="lp3-meter"><i data-raw-meter style="width:86%"></i></div>
            </div>

            <div class="lp3-gate" data-gate>
              <div class="lp3-gate-core">
                <img
                  class="lp3-gate-mark"
                  src="/brand/box-logo-white.webp"
                  alt=""
                  width="96"
                  height="96"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <span class="lp3-gate-label">RTK</span>
            </div>

            <div class="lp3-panel lp3-panel-clean">
              <div class="lp3-panel-head">
                <span><i class="dot"></i>{t('v3.hero.panel_clean', lang)}</span>
                <span class="pct" data-clean-pct>73% used</span>
              </div>
              <div class="lp3-panel-body">
                {cleanCells.map(c =>
                  c.t !== undefined ? (
                    <i class="lp3-cell t-keep" style="--a:0.9" data-t={c.t}></i>
                  ) : (
                    <i class="lp3-cell empty"></i>
                  )
                )}
              </div>
              <div class="lp3-meter"><i data-clean-meter style="width:73%"></i></div>
            </div>

          </div>
        </div>
      </div>

      <div class="lp3-hero-proofwrap" data-hero-proof>
        <div class="lp3-container" aria-label={t('v3.hero.aria_adoption', lang)}>
          <div class="lp3-hero-proof">
            {stats.map(s => (
              <div class="lp3-hero-stat" data-stat>
                <div class="num" data-count={s.num}>{s.num}</div>
                <div class="lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
