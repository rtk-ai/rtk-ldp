---
import { t, type Lang } from '../../../lib/i18n'

interface Props {
  lang?: Lang
}
const { lang = 'en' } = Astro.props

const features = [
  { k: t('v3.pro.f1_title', lang), v: t('v3.pro.f1_text', lang) },
  { k: t('v3.pro.f2_title', lang), v: t('v3.pro.f2_text', lang) },
  { k: t('v3.pro.f3_title', lang), v: t('v3.pro.f3_text', lang) },
  { k: t('v3.pro.f4_title', lang), v: t('v3.pro.f4_text', lang) },
  { k: t('v3.pro.f5_title', lang), v: t('v3.pro.f5_text', lang) },
  { k: t('v3.pro.f6_title', lang), v: t('v3.pro.f6_text', lang) },
]
---
<section class="lp3-section lp3-prosec" id="pro">
  <div class="lp3-container">
    <div class="lp3-pro reveal">

      <div class="lp3-pro-top">
        <div class="lp3-pro-head">
          <p class="lp3-eyebrow lp3-pro-eyebrow">
            <span class="dot" aria-hidden="true"></span>{t('v3.pro.eyebrow', lang)}
          </p>
          <h2 class="lp3-pro-title" set:html={t('v3.pro.title', lang)}></h2>
          <div class="lp3-pro-actions">
            <a href="https://pro.rtk-ai.app/pricing" class="lp3-btn lp3-btn-primary" target="_blank" rel="noopener">
              {t('v3.pro.d2_cta', lang)} <span aria-hidden="true">↗</span>
            </a>
            <a href="https://pro.rtk-ai.app/contact" class="lp3-btn lp3-btn-ghost" target="_blank" rel="noopener">
              {t('v3.pro.d2_cta2', lang)} <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="lp3-pro-solo">
            {t('v3.pro.solo_q', lang)}
            <a href="https://pro.rtk-ai.app/pricing" target="_blank" rel="noopener">{t('v3.pro.solo_cta', lang)} <span aria-hidden="true">→</span></a>
          </p>
          <p class="lp3-pro-note">{t('v3.pro.note', lang)}</p>
        </div>

        <ul class="lp3-pro-list" role="list" data-xp>
          {features.map((f, i) => (
            <li class:list={['lp3-pro-row', { 'is-on': i === 0 }]} data-xp-row>
              <button type="button" data-xp-item aria-expanded={i === 0 ? 'true' : 'false'}>
                <span class="n" aria-hidden="true">0{i + 1}</span>
                <span class="k">{f.k}</span>
                <span class="pm" aria-hidden="true"></span>
              </button>
              <p class="v">{f.v}</p>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
