---
// Landing Footer — rich multi-column layout with install, docs, community, ecosystem columns
const currentYear = new Date().getFullYear()

let version = 'v0.37.1'

try {
  const headers: Record<string, string> = { 'User-Agent': 'rtk-landing' }
  const token = process.env.GITHUB_TOKEN
  if (token) headers['Authorization'] = `Bearer ${token}`

  const res = await fetch('https://api.github.com/repos/rtk-ai/rtk/releases/latest', { headers })
  if (res.ok) {
    const data = await res.json()
    if (data.tag_name) version = data.tag_name.startsWith('v') ? data.tag_name : `v${data.tag_name}`
  }
} catch {}
