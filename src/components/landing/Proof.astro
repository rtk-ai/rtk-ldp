---
// Proof section — 2 real rtk gain screenshots from a happy developer
import { t, type Lang } from '../../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---
<section class="proof-section" id="proof">
  <div class="section-inner">
    <h2 >{t('proof.title', lang)}</h2>
    <p class="section-sub" set:html={t('proof.sub', lang)}></p>

    <div class="proof-row">
      <div class="proof-text">
        <h3>{t('proof.h1', lang)}</h3>
        <p set:html={t('proof.d1', lang)}></p>
        <span class="metric metric-green">88.9% efficiency</span>
      </div>
      <div class="proof-img">
        <img src="/assets/screenshots/rtkgain02.webp" alt="rtk gain dashboard showing 88.9% efficiency" loading="lazy" width="1370" height="840">
      </div>
    </div>

    <div class="proof-row proof-row-reverse">
      <div class="proof-text">
        <h3>{t('proof.h2', lang)}</h3>
        <p>{t('proof.d2', lang)}</p>
        <span class="metric metric-cyan">Per-command analytics</span>
      </div>
      <div class="proof-img">
        <img src="/assets/screenshots/rtkgain01.webp" alt="rtk gain daily and weekly breakdown" loading="lazy" width="609" height="967">
      </div>
    </div>
  </div>
</section>

<style>
.proof-section { background: var(--bg-card); }

.proof-row {
  display: flex;
  align-items: center;
  gap: 56px;
  margin-bottom: 56px;
}

.proof-row:last-child { margin-bottom: 0; }
.proof-row-reverse { flex-direction: row-reverse; }

.proof-text { flex: 1; min-width: 0; }

.proof-text h3 {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--text-bright);
}

.proof-text p {
  color: var(--text-muted);
  font-size: 0.95rem;
  line-height: 1.65;
  margin-bottom: var(--space-4);
}

.proof-img {
  flex: 1.2;
  min-width: 0;
  max-width: 560px;
}

.proof-img img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-light);
  box-shadow:
    0 4px 24px rgba(0, 0, 0, 0.4),
    0 0 0 1px rgba(255, 255, 255, 0.04),
    0 20px 60px rgba(0, 0, 0, 0.3);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.proof-img img:hover {
  transform: scale(1.02);
  box-shadow:
    0 8px 40px rgba(0, 0, 0, 0.5),
    0 1px 0 rgba(255, 255, 255, 0.06) inset;
}

@media (max-width: 768px) {
  .proof-row, .proof-row-reverse { flex-direction: column; gap: 28px; }
  .proof-img { max-width: 100%; }
}

</style>
