---
// Hero section — two-column: content left, terminal right (Identity Redesign v2)
import { t, type Lang } from '../../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props

let stars = 31000

try {
  const headers: Record<string, string> = { 'User-Agent': 'rtk-landing' }
  const token = process.env.GITHUB_TOKEN
  if (token) headers['Authorization'] = `Bearer ${token}`

  const res = await fetch('https://api.github.com/repos/rtk-ai/rtk', { headers })
  if (res.ok) {
    const data = await res.json()
    if (data.stargazers_count) stars = data.stargazers_count
  }
} catch {}

const starsLabel = stars >= 1000 ? `${(stars / 1000).toFixed(1)}k` : String(stars)
---
<section class="hero">
  <div class="hero-inner">

    <!-- Left: content -->
    <div class="hero-content">
      <div class="hero-eyebrow">// {t('hero.badge_oss', lang)}</div>

      <h1 class="hero-h1">
        {t('hero.title_1', lang)}<br>
        {t('hero.title_2', lang)}<br>
        <span class="hero-accent">{t('hero.title_3', lang)}</span>
      </h1>

      <p class="hero-sub">{t('hero.sub_1', lang)} {t('hero.sub_2', lang)}</p>

      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">89%</span>
          <span class="stat-label">token reduction</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-value">24.6M</span>
          <span class="stat-label">tokens saved</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-value" id="github-stars-count">{starsLabel}</span>
          <span class="stat-label">GitHub stars</span>
        </div>
      </div>

      <div class="hero-cta">
        <a href="#install" class="btn btn-primary">{t('hero.cta_install', lang)}</a>
        <a href="https://github.com/rtk-ai/rtk" class="btn btn-ghost" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>{t('hero.cta_star', lang)}</span>
        </a>
      </div>
    </div>

    <!-- Right: terminal -->
    <div class="hero-terminal-col">
      <div class="terminal-demo">
        <div class="terminal-header" aria-hidden="true">
          <div class="terminal-dot r"></div>
          <div class="terminal-dot y"></div>
          <div class="terminal-dot g"></div>
          <span class="terminal-title">Terminal</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-block">
            <span class="dim">// before</span><br>
            <span class="prompt">$</span> <span class="cmd">git status</span><br>
            <span class="waste">On branch main</span><br>
            <span class="waste">Your branch is up to date with 'origin/main'.</span><br>
            <span class="waste">&nbsp;</span><br>
            <span class="waste">Changes not staged for commit:</span><br>
            <span class="waste">&nbsp; (use "git add &lt;file&gt;..." to update)</span><br>
            <span class="waste">&nbsp; (use "git restore &lt;file&gt;..." to discard)</span><br>
            <span class="waste">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;modified:&nbsp;&nbsp;src/styles/global.css</span><br>
            <span class="waste">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;modified:&nbsp;&nbsp;src/components/Hero.astro</span><br>
            <span class="waste">&nbsp;</span><br>
            <span class="waste">no changes added to commit</span>
          </div>

          <div class="terminal-divider"></div>

          <div class="terminal-block">
            <span class="dim">// after</span><br>
            <span class="prompt">$</span> <span class="cmd">rtk git status</span><br>
            <span class="ok">M</span> <span class="ok-file">src/styles/global.css</span><br>
            <span class="ok">M</span> <span class="ok-file">src/components/Hero.astro</span><br>
            <span class="saving">&#x2193; 80.8% tokens saved</span>
          </div>

          <div class="terminal-prompt-line">
            <span class="prompt">$</span> <span class="cursor-blink" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <div class="hero-compat">
        <span class="compat-label">Works with</span>
        <div class="compat-tools">
          <span>Claude Code</span>
          <span>Cursor</span>
          <span>Codex</span>
          <span>Copilot</span>
          <span>Gemini CLI</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.hero {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 140px 24px 80px;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

/* ── Left column ── */
.hero-content {
  min-width: 0;
}

.hero-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-dim);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-5);
}

.hero-h1 {
  font-size: clamp(2.75rem, 5vw, 4.5rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.04;
  margin: 0 0 var(--space-5);
  color: var(--text-bright);
}

.hero-accent {
  color: var(--accent);
}

.hero-sub {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin: 0 0 var(--space-6);
  max-width: 480px;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: var(--space-7);
  margin-bottom: var(--space-7);
}

.stat { text-align: left; }

.stat-value {
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--accent);
  display: block;
  line-height: 1;
}

.stat-label {
  font-size: var(--text-xs);
  color: var(--text-dim);
  display: block;
  margin-top: 0.25rem;
}

.stat-sep {
  width: 1px;
  height: 2rem;
  background: var(--border);
  flex-shrink: 0;
}

.hero-cta {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

/* ── Right column ── */
.hero-terminal-col {
  min-width: 0;
}

.terminal-demo {
  border: 1px solid var(--border-light);
  border-radius: var(--radius);
  background: var(--bg-card);
  overflow: hidden;
  box-shadow: var(--shadow-elevated);
}

.terminal-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 12px 16px;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--border);
}

.terminal-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.terminal-dot.r { background: #ef4444; }
.terminal-dot.y { background: #eab308; }
.terminal-dot.g { background: #22c55e; }

.terminal-title {
  margin-left: 8px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-dim);
}

.terminal-body {
  padding: 20px;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  line-height: 1.75;
}

.terminal-block {
  margin-bottom: 0;
}

.terminal-divider {
  border: none;
  border-top: 1px solid var(--border);
  margin: 14px 0;
}

.terminal-prompt-line {
  margin-top: 10px;
}

.terminal-body .prompt   { color: var(--accent); font-weight: 600; }
.terminal-body .cmd      { color: var(--text-bright); }
.terminal-body .dim      { color: var(--text-dim); }
.terminal-body .waste    { color: var(--text-dim); opacity: 0.55; }
.terminal-body .ok       { color: var(--accent); font-weight: 600; }
.terminal-body .ok-file  { color: var(--text-muted); }
.terminal-body .saving   { color: var(--accent); font-size: 0.72rem; }

.cursor-blink {
  display: inline-block;
  width: 8px;
  height: 14px;
  background: var(--accent);
  vertical-align: text-bottom;
  animation: blink 1s step-end infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

/* ── Compat strip ── */
.hero-compat {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-4);
  flex-wrap: wrap;
}

.compat-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-dim);
  white-space: nowrap;
}

.compat-tools {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.compat-tools span {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-dim);
  padding: 3px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  white-space: nowrap;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .hero-inner {
    grid-template-columns: 1fr;
    gap: var(--space-9);
  }
  .hero { padding: 120px 20px 60px; }
  .hero-h1 { font-size: clamp(2.4rem, 7vw, 3.5rem); }
  .hero-sub { max-width: none; }
  .hero-stats { gap: var(--space-5); }
}

@media (max-width: 480px) {
  .hero-stats { gap: var(--space-4); }
  .stat-value { font-size: 1.25rem; }
}
</style>
