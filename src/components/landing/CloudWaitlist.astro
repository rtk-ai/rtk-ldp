---
// CloudWaitlist — RTK Cloud "Coming Soon" section with waitlist form
---
<section class="cloud-section" id="cloud">
  <div class="section-inner">
    <div class="cloud-card reveal">
      <div class="cloud-badge"><span data-i18n="cloud.badge">Coming Soon</span></div>
      <h2>RTK Cloud</h2>
      <p class="cloud-desc" data-i18n="cloud.desc">Visibility and control over your team's AI coding costs. Know what's wasted. Fix it.</p>

      <div class="cloud-features">
        <div class="cloud-feature">
          <span class="cloud-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="var(--violet)"/></svg>
          </span>
          <div>
            <h4 data-i18n="cloud.f1.title">Token analytics</h4>
            <p data-i18n="cloud.f1.desc">Dashboard per dev, per project, per tool</p>
          </div>
        </div>
        <div class="cloud-feature">
          <span class="cloud-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10" stroke="var(--accent)"/><path d="M12 20V4"/><path d="M6 20v-6" stroke="var(--accent)"/></svg>
          </span>
          <div>
            <h4 data-i18n="cloud.f2.title">Team savings reports</h4>
            <p data-i18n="cloud.f2.desc">"Your team saved $4,200 this month"</p>
          </div>
        </div>
        <div class="cloud-feature">
          <span class="cloud-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13" stroke="var(--text-bright)"/><line x1="12" y1="17" x2="12.01" y2="17" stroke="var(--text-bright)"/></svg>
          </span>
          <div>
            <h4 data-i18n="cloud.f3.title">Rate limit alerts</h4>
            <p data-i18n="cloud.f3.desc">Monitoring &amp; smart notifications</p>
          </div>
        </div>
        <div class="cloud-feature">
          <span class="cloud-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--violet)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="6" x2="9.01" y2="6" stroke="var(--accent)"/><line x1="15" y1="6" x2="15.01" y2="6" stroke="var(--accent)"/><line x1="9" y1="10" x2="9.01" y2="10" stroke="var(--accent)"/><line x1="15" y1="10" x2="15.01" y2="10" stroke="var(--accent)"/><line x1="9" y1="14" x2="9.01" y2="14" stroke="var(--accent)"/><line x1="15" y1="14" x2="15.01" y2="14" stroke="var(--accent)"/><path d="M9 18h6"/></svg>
          </span>
          <div>
            <h4 data-i18n="cloud.f4.title">Enterprise controls</h4>
            <p data-i18n="cloud.f4.desc">SSO, audit logs, compliance</p>
          </div>
        </div>
      </div>

      <p class="cloud-pricing" data-i18n-html="cloud.pricing">Free for open-source. Teams from <strong>$15/dev/month</strong>.</p>

      <form class="waitlist-form" id="waitlist-form">
        <div class="waitlist-row">
          <input type="email" id="wl-email" class="wl-input" data-i18n-placeholder="cloud.placeholder_email" placeholder="you@company.com" required>
          <input type="text" id="wl-company" class="wl-input" data-i18n-placeholder="cloud.placeholder_company" placeholder="Company (optional)">
        </div>
        <select id="wl-tool" class="wl-select">
          <option value="" data-i18n="cloud.placeholder_tool">Main AI coding tool (optional)</option>
          <option value="claude-code">Claude Code</option>
          <option value="cursor">Cursor</option>
          <option value="gemini-cli">Gemini CLI</option>
          <option value="aider">Aider</option>
          <option value="codex">OpenAI Codex</option>
          <option value="windsurf">Windsurf</option>
          <option value="cline">Cline / Roo</option>
          <option value="copilot">GitHub Copilot</option>
          <option value="other">Other</option>
        </select>
        <button type="submit" class="wl-submit" id="wl-submit" data-i18n="cloud.submit">Join the waitlist</button>
      </form>

      <p class="waitlist-count"><span id="waitlist-count">0</span> <span data-i18n="cloud.counter">teams on the waitlist</span></p>
      <p class="waitlist-note" data-i18n="cloud.note">No spam. One email when we launch.</p>

      <div class="wl-spread" id="wl-spread" style="display:none">
        <div class="wl-spread-label" data-i18n="cloud.spread">Spread the word</div>
        <div class="wl-spread-links">
          <a href="https://x.com/intent/tweet?text=Just%20joined%20the%20RTK%20Cloud%20waitlist%20%E2%80%94%20centralized%20token%20analytics%20for%20AI%20coding%20teams.%20Your%20agents%20get%2089%25%20less%20noise.&url=https%3A%2F%2Frtk-ai.app" target="_blank" rel="noopener nofollow" class="share-btn" aria-label="Share on X">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://bsky.app/intent/compose?text=Just%20joined%20the%20RTK%20Cloud%20waitlist%20%E2%80%94%20centralized%20token%20analytics%20for%20AI%20coding%20teams.%20https%3A%2F%2Frtk-ai.app" target="_blank" rel="noopener nofollow" class="share-btn" aria-label="Share on Bluesky">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.601 3.495 6.186 3.245-3.775.547-7.052 2.48-4.452 7.378 2.294 3.796 5.057 4.755 7.642.38C12 17.764 12 14.568 12 14.568s0 3.196 2 6.682c2.585 4.375 5.348 3.416 7.642-.38 2.6-4.898-.677-6.831-4.452-7.378 2.585.25 5.401-.618 6.186-3.245.246-.828.624-5.788.624-6.479 0-.688-.139-1.86-.902-2.203-.659-.299-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8z"/></svg>
          </a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Frtk-ai.app" target="_blank" rel="noopener nofollow" class="share-btn" aria-label="Share on LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
        <a href="#share-gain" class="wl-spread-gain" data-i18n="cloud.post_gain">or post your rtk gain</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Fetch waitlist count
  fetch('https://api.rtk-ai.app/waitlist/count')
    .then(r => r.json())
    .then(data => {
      const el = document.getElementById('waitlist-count')
      if (el && data.count != null) el.textContent = String(data.count)
    })
    .catch(() => {})

  // Waitlist form submission
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const btn = document.getElementById('wl-submit') as HTMLButtonElement
      const original = btn.textContent
      btn.textContent = 'Joining...'
      btn.disabled = true

      try {
        const res = await fetch('https://api.rtk-ai.app/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: (document.getElementById('wl-email') as HTMLInputElement).value,
            company: (document.getElementById('wl-company') as HTMLInputElement).value,
            tool: (document.getElementById('wl-tool') as HTMLSelectElement).value,
          })
        })

        if (res.ok || res.status === 409) {
          btn.textContent = res.status === 409 ? '✓ Already on the list!' : "✓ You're on the list!"
          btn.style.background = 'var(--accent)'
          btn.style.borderColor = 'var(--accent)'
          btn.style.color = '#000'
          form.style.display = 'none'
          const spread = document.getElementById('wl-spread')
          if (spread) spread.style.display = 'block'
          // Update count
          fetch('https://api.rtk-ai.app/waitlist/count')
            .then(r => r.json())
            .then(data => {
              const el = document.getElementById('waitlist-count')
              if (el && data.count != null) el.textContent = String(data.count)
            })
            .catch(() => {})
        } else {
          btn.textContent = 'Error, try again'
          btn.disabled = false
          setTimeout(() => { btn.textContent = original!; btn.disabled = false }, 3000)
        }
      } catch {
        btn.textContent = 'Error — try again'
        btn.disabled = false
        setTimeout(() => { btn.textContent = original!; btn.disabled = false }, 3000)
      }
    })
  }
</script>
