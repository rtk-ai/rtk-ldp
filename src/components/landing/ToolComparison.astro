---
// ToolComparison: 8 AI tool cards with session callout + expandable detail
import { t, type Lang } from '../../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---
<section class="comparison" id="compare">
  <div class="section-inner">
    <h2 class="reveal">{t('compare.title', lang)}</h2>
    <p class="section-sub reveal">{t('compare.sub', lang)}</p>

    <div class="session-callout reveal">
      <p class="session-headline">{t('compare.session_headline', lang)}</p>
      <div class="session-stats-row">
        <div class="session-stat">
          <span class="session-num">~60</span>
          <span class="session-label">{t('compare.session_cmds', lang)}</span>
        </div>
        <div class="session-stat">
          <span class="session-num session-num-red">~210K</span>
          <span class="session-label">{t('compare.session_noise', lang)}</span>
        </div>
        <div class="session-stat">
          <span class="session-num session-num-accent">~23K</span>
          <span class="session-label">{t('compare.session_rtk', lang)}</span>
        </div>
      </div>
      <p class="session-note">{t('compare.session_note', lang)}</p>
    </div>

    <div class="tool-cards">

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">Claude Code</span>
          <span class="tool-type type-terminal">Terminal</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">$20 &mdash; $200/mo</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_cc', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">200K tokens</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_cc', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_cc', lang)}</div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">Cursor</span>
          <span class="tool-type type-ide">IDE</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">$20 &mdash; $200/mo</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_cursor', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">{t('compare.ctx_cursor', lang)}</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_cursor', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_cursor', lang)}</div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">OpenAI Codex</span>
          <span class="tool-type type-agent">Agent</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">{t('compare.price_codex', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_codex', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">192K tokens</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_codex', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_codex', lang)}</div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">Windsurf</span>
          <span class="tool-type type-ide">IDE</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">$15 &mdash; $60/mo</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_windsurf', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">200K tokens</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_windsurf', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_windsurf', lang)}</div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">Gemini CLI</span>
          <span class="tool-type type-terminal">Terminal</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">{t('compare.price_gemini', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_gemini', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">1M tokens</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_gemini', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_gemini', lang)}</div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">Aider</span>
          <span class="tool-type type-terminal">Terminal</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">{t('compare.price_aider', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_aider', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">{t('compare.ctx_model', lang)}</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_aider', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_aider', lang)}</div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">GitHub Copilot</span>
          <span class="tool-type type-ide">IDE</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">{t('compare.price_copilot', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_copilot', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">{t('compare.ctx_model', lang)}</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_copilot', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_copilot', lang)}</div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-card-header">
          <span class="tool-card-name">Cline / Roo</span>
          <span class="tool-type type-agent">VS Code</span>
        </div>
        <div class="tool-card-specs">
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_price', lang)}</span><span class="tool-card-value">{t('compare.price_cline', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_limits', lang)}</span><span class="tool-card-value">{t('compare.limit_cline', lang)}</span></div>
          <div class="tool-card-row"><span class="tool-card-label">{t('compare.th_context', lang)}</span><span class="tool-card-value">{t('compare.ctx_model', lang)}</span></div>
        </div>
        <div class="tool-card-impact"><span class="impact-badge impact-green">{t('compare.impact_cline', lang)}</span></div>
        <div class="tool-card-detail">{t('compare.detail_cline', lang)}</div>
      </div>

    </div>
    <p class="section-sub" style="font-size:0.72rem; margin-top:20px; opacity:0.5;">{t('compare.footnote', lang)}</p>
  </div>
</section>

<style>
.comparison { background: var(--bg); }

.tool-type {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  font-size: 0.68rem;
  font-weight: 600;
}

.type-terminal { background: var(--accent-dim); color: var(--accent); }
.type-ide { background: var(--cyan-dim); color: var(--cyan); }
.type-agent { background: var(--violet-dim); color: var(--violet); }

.impact-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  font-weight: 700;
  font-size: 0.78rem;
  font-family: var(--font-mono);
}

.impact-green {
  background: var(--accent-dim);
  color: var(--accent);
}

.tool-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 40px;
}

.tool-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
}

.tool-card:hover {
  border-color: var(--border-light);
  transform: translateY(-3px);
  box-shadow: var(--shadow-card-hover), var(--shadow-glow-green);
}

.tool-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.tool-card-name {
  font-weight: 700;
  font-size: 1.05rem;
  color: var(--text-bright);
}

.tool-card-specs {
  padding: 0;
}

.tool-card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9px 20px;
  border-bottom: 1px solid var(--border);
  font-size: 0.82rem;
}

.tool-card-row:last-child {
  border-bottom: none;
}

.tool-card-label {
  color: var(--text-muted);
  font-weight: 500;
}

.tool-card-value {
  color: var(--text);
  font-weight: 600;
  text-align: right;
}

.tool-card-impact {
  padding: 12px 20px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-3);
}

.tool-card-impact .waste-badge {
  font-size: 0.76rem;
}

.tool-card-detail {
  padding: 14px 20px;
  border-top: 1px solid var(--border);
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.55;
  background: rgba(0, 229, 153, 0.02);
}

.session-callout {
  background: linear-gradient(135deg, var(--bg-card) 0%, rgba(0, 229, 153, 0.03) 100%);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  margin: 40px 0 12px;
  text-align: center;
  box-shadow: var(--shadow-card), 0 0 0 1px rgba(0, 229, 153, 0.04) inset;
}

.session-headline {
  color: var(--text-bright);
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 20px;
}

.session-stats-row {
  display: flex;
  justify-content: center;
  gap: var(--space-8);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
}

.session-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.session-num {
  font-family: var(--font-mono);
  font-size: 1.7rem;
  font-weight: 800;
  color: var(--text-bright);
  line-height: 1.2;
}

.session-num-red { color: var(--red); }
.session-num-accent { color: var(--accent); }

.session-label {
  font-size: 0.76rem;
  color: var(--text-muted);
  margin-top: 4px;
}

.session-note {
  font-size: 0.78rem;
  color: var(--text-dim);
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .tool-cards { grid-template-columns: 1fr; }
  .tool-card-detail { font-size: 0.76rem; }
  .session-callout { padding: 20px 16px; }
  .session-stats-row { gap: var(--space-5); }
  .session-num { font-size: 1.3rem; }
}
</style>
