---
// Capabilities — "Context Forge" suite section
// Shows RTK + ICM + Vox as a coherent 3-tool suite
import Eyebrow from './Eyebrow.astro'

const tools = [
  {
    label: 'RTK',
    verb: 'Compress',
    verbKey: 'caps.rtk.verb',
    color: 'var(--accent)',
    href: '/#install',
    description: 'Commands, file reads, tests — compressed 60-90% before they reach your model context. Zero config.',
    descKey: 'caps.rtk.desc',
    stat: '89% noise removed',
    statKey: 'caps.rtk.stat',
  },
  {
    label: 'ICM',
    verb: 'Remember',
    verbKey: 'caps.icm.verb',
    color: 'var(--cyan)',
    href: '/icm/',
    description: 'Persistent memory across sessions. Your agent picks up where it left off — decisions, errors, context.',
    descKey: 'caps.icm.desc',
    stat: 'Infinite context memory',
    statKey: 'caps.icm.stat',
  },
  {
    label: 'Vox',
    verb: 'Speak',
    verbKey: 'caps.vox.verb',
    color: 'var(--violet)',
    href: '/vox/',
    description: 'Voice output for your AI agent. Three TTS backends, four Claude Code integration modes.',
    descKey: 'caps.vox.desc',
    stat: '3 TTS backends',
    statKey: 'caps.vox.stat',
  },
]
---

<section class="capabilities section-calm" aria-labelledby="capabilities-title">
  <div class="capabilities-inner">
    <Eyebrow label="context forge" />
    <h2 id="capabilities-title" class="capabilities-title">
      <span data-i18n="caps.title_1">One forge.</span> <span class="gradient-text" data-i18n="caps.title_2">Three tools.</span>
    </h2>
    <p class="capabilities-sub" data-i18n="caps.sub">RTK, ICM, and Vox share one philosophy: open source, Rust, zero telemetry, local-first.</p>

    <div class="capabilities-grid">
      {tools.map((t) => (
        <a href={t.href} class="capabilities-card card-muted">
          <div class="capabilities-card-header">
            <span class="capabilities-label" style={`color: ${t.color}`}>{t.label}</span>
            <span class="capabilities-verb" data-i18n={t.verbKey}>{t.verb}</span>
          </div>
          <p class="capabilities-desc" data-i18n={t.descKey}>{t.description}</p>
          <span class="capabilities-stat pill-neutral" data-i18n={t.statKey}>{t.stat}</span>
        </a>
      ))}
    </div>
  </div>
</section>
