---
// ShareGain — paste rtk gain output, parse stats, share on social
import { t, type Lang } from '../../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---
<section class="share-gain" id="share-gain">
  <div class="section-inner">
    <div class="section-viking" style="margin-bottom:32px;">
      <img src="/assets/illustrations/viking-share.webp" alt="Viking raising axe in triumphant war cry" loading="lazy" width="1920" height="1047">
    </div>
    <div class="share-gain-card">
      <h2>
        <span>{t('share.title_1', lang)}</span> <span class="gradient-text">{t('share.title_2', lang)}</span>
      </h2>
      <p class="share-gain-desc" set:html={t('share.desc', lang)}></p>

      <textarea class="gain-textarea" id="gain-paste" rows="6" placeholder={t('share.paste_placeholder', lang)}></textarea>

      <div class="gain-preview" id="gain-preview" style="display:none;">
        <span class="gp-highlight">&#x26A1; My rtk gain:</span> <span id="gp-tokens">___</span> tokens saved (<span id="gp-pct">___</span>) over <span id="gp-cmds">___</span> commands.
        <br>That's <span id="gp-pct2">___</span> less noise in my AI's context window.
        <br><br>github.com/rtk-ai/rtk
      </div>

      <div class="gain-share-btns">
        <a id="gain-share-x" href="#" target="_blank" rel="noopener nofollow" class="gain-share-btn" aria-label={t('aria.share_x', lang)}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>{t('share.post_x', lang)}</span>
        </a>
        <a id="gain-share-bsky" href="#" target="_blank" rel="noopener nofollow" class="gain-share-btn" aria-label={t('aria.share_bsky', lang)}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.601 3.495 6.186 3.245-3.775.547-7.052 2.48-4.452 7.378 2.294 3.796 5.057 4.755 7.642.38C12 17.764 12 14.568 12 14.568s0 3.196 2 6.682c2.585 4.375 5.348 3.416 7.642-.38 2.6-4.898-.677-6.831-4.452-7.378 2.585.25 5.401-.618 6.186-3.245.246-.828.624-5.788.624-6.479 0-.688-.139-1.86-.902-2.203-.659-.299-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8z"/></svg>
          <span>{t('share.post_bsky', lang)}</span>
        </a>
        <a id="gain-share-li" href="#" target="_blank" rel="noopener nofollow" class="gain-share-btn" aria-label={t('aria.share_linkedin', lang)}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span>{t('share.linkedin', lang)}</span>
        </a>
        <button id="gain-copy-btn" class="gain-share-btn" aria-label={t('aria.copy', lang)}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          <span>{t('share.copy', lang)}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const textarea = document.getElementById('gain-paste') as HTMLTextAreaElement | null
  const preview = document.getElementById('gain-preview') as HTMLElement | null

  function parseGain(text: string) {
    const tokensMatch = text.match(/Tokens saved:\s*([\d.,]+[KMB]?)\s*\((\d+(?:\.\d+)?%)\)/)
    const cmdsMatch = text.match(/Total commands:\s*([\d,]+)/)
    return {
      tokens: tokensMatch?.[1] ?? null,
      pct: tokensMatch?.[2] ?? null,
      cmds: cmdsMatch?.[1] ?? null,
    }
  }

  function updatePreview() {
    if (!textarea || !preview) return
    const text = textarea.value.trim()
    if (!text) { preview.style.display = 'none'; return }
    const { tokens, pct, cmds } = parseGain(text)
    if (!tokens) { preview.style.display = 'none'; return }

    const gpTokens = document.getElementById('gp-tokens')
    const gpPct = document.getElementById('gp-pct')
    const gpCmds = document.getElementById('gp-cmds')
    const gpPct2 = document.getElementById('gp-pct2')
    if (gpTokens) gpTokens.textContent = tokens
    if (gpPct) gpPct.textContent = pct ?? '?'
    if (gpCmds) gpCmds.textContent = cmds ?? '?'
    if (gpPct2) gpPct2.textContent = pct ?? '?'
    preview.style.display = 'block'

    const shareText = `⚡ My rtk gain: ${tokens} tokens saved (${pct ?? '?'}) over ${cmds ?? '?'} commands.\nThat's ${pct ?? '?'} less noise in my AI's context window.\n\ngithub.com/rtk-ai/rtk`
    const encoded = encodeURIComponent(shareText)

    const xLink = document.getElementById('gain-share-x') as HTMLAnchorElement | null
    const bskyLink = document.getElementById('gain-share-bsky') as HTMLAnchorElement | null
    const liLink = document.getElementById('gain-share-li') as HTMLAnchorElement | null
    if (xLink) xLink.href = `https://x.com/intent/tweet?text=${encoded}`
    if (bskyLink) bskyLink.href = `https://bsky.app/intent/compose?text=${encoded}`
    if (liLink) liLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fgithub.com%2Frtk-ai%2Frtk`

    const copyBtn = document.getElementById('gain-copy-btn')
    if (copyBtn) {
      copyBtn.onclick = () => {
        navigator.clipboard.writeText(shareText).catch(() => {})
        const span = copyBtn.querySelector('span')
        if (span) { const orig = span.textContent; span.textContent = 'Copied!'; setTimeout(() => span.textContent = orig, 1500) }
      }
    }
  }

  if (textarea) {
    textarea.addEventListener('input', updatePreview)
  }
</script>

<style>
.share-gain { background: var(--bg); }

.share-gain-card {
  max-width: 600px;
  margin: 0 auto;
  padding: 40px 36px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  text-align: center;
}

.share-gain-card h2 {
  font-size: 1.8rem;
  margin-bottom: 10px;
}

.share-gain-desc {
  color: var(--text-muted);
  font-size: 0.92rem;
  margin-bottom: var(--space-5);
}

.gain-textarea {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--bg);
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  line-height: 1.5;
  outline: none;
  resize: vertical;
  transition: border-color 0.2s;
  margin-bottom: var(--space-4);
}
.gain-textarea:focus { border-color: var(--accent); }
.gain-textarea::placeholder { color: var(--text-dim); }

.gain-preview {
  padding: 16px 20px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--bg);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-bottom: 20px;
  text-align: left;
  min-height: 60px;
}

.gain-preview .gp-highlight { color: var(--accent); font-weight: 600; }

.gain-share-btns {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
}

.gain-share-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 10px 20px;
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-weight: 600;
  font-family: var(--font-body);
  border: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text);
  cursor: pointer;
  transition: border-color 0.2s, transform 0.2s;
}
.gain-share-btn:hover {
  border-color: var(--accent);
  transform: translateY(-1px);
  text-decoration: none;
}
.gain-share-btn svg { flex-shrink: 0; }
</style>
