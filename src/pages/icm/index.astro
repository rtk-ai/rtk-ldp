  <script>
    import { initCopyButtons } from '../../scripts/copy'
    initCopyButtons()

    // Flow Animation
    (function() {
      var AGENTS = [
        { name: 'Claude Code', color: '#22d3ee' },
        { name: 'Cursor', color: '#a78bfa' },
        { name: 'Windsurf', color: '#4ade80' },
        { name: 'Copilot', color: '#f472b6' },
        { name: 'Cline', color: '#fbbf24' },
        { name: 'Codex', color: '#fb923c' }
      ]
      var MEM_LABELS = [
        'JWT auth', 'DB schema', 'API routes', 'deploy cfg',
        'env vars', 'tests', 'CI/CD', 'error log',
        'models', 'rate limit', 'webhooks', 'monitoring'
      ]
      var CX = 400, CY = 250, ICM_R = 42
      var numAgents = 3, numMemories = 4
      var currentStep = -1, steps = [], autoInterval = null, playing = false

      var svgEl = document.getElementById('flow-svg')
      var logEl = document.getElementById('flow-log')
      var playBtn = document.getElementById('flow-play')
      var stepBtn = document.getElementById('flow-step')
      var resetBtn = document.getElementById('flow-reset')

      if (!svgEl || !logEl || !playBtn || !stepBtn || !resetBtn) return

      function agentPos(i) {
        var a = (i / numAgents) * 2 * Math.PI - Math.PI / 2
        return { x: Math.round(CX + 260 * Math.cos(a)), y: Math.round(CY + 175 * Math.sin(a)) }
      }
      function memPos(i) {
        var r = numMemories <= 4 ? 78 : numMemories <= 8 ? 88 : 98
        var a = (i / numMemories) * 2 * Math.PI - Math.PI / 4
        return { x: Math.round(CX + r * Math.cos(a)), y: Math.round(CY + r * Math.sin(a)), a: a, r: r }
      }
      function buildSVG() {
        var h = '<defs><radialGradient id="icm-glow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#22d3ee" stop-opacity="0.15"/><stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/></radialGradient></defs>'
        h += '<circle cx="'+CX+'" cy="'+CY+'" r="120" fill="url(#icm-glow)"/>'
        for (var i = 0; i < numAgents; i++) {
          var p = agentPos(i), dx = p.x - CX, dy = p.y - CY
          var dist = Math.sqrt(dx*dx + dy*dy)
          var ex = Math.round(CX + dx * (ICM_R + 4) / dist)
          var ey = Math.round(CY + dy * (ICM_R + 4) / dist)
          h += '<line id="line-'+i+'" x1="'+p.x+'" y1="'+p.y+'" x2="'+ex+'" y2="'+ey+'" stroke="'+AGENTS[i].color+'" stroke-width="1.5" stroke-opacity="0.15" stroke-dasharray="6 4"/>'
        }
        for (var i = 0; i < numAgents; i++) {
          h += '<circle id="particle-'+i+'" cx="0" cy="0" r="4" fill="'+AGENTS[i].color+'" opacity="0"/>'
        }
        h += '<circle cx="'+CX+'" cy="'+CY+'" r="'+ICM_R+'" fill="#111113" stroke="#22d3ee" stroke-width="2"/>'
        h += '<text x="'+CX+'" y="'+(CY-6)+'" text-anchor="middle" fill="#22d3ee" font-size="16" font-weight="800" font-family="\'JetBrains Mono\', monospace">ICM</text>'
        h += '<text x="'+CX+'" y="'+(CY+12)+'" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="\'Inter\', sans-serif">22 MCP tools</text>'
        h += '<g id="mem-nodes">'
        var fs = numMemories <= 4 ? 7.5 : numMemories <= 8 ? 6.5 : 0
        for (var i = 0; i < numMemories; i++) {
          var mp = memPos(i), col = AGENTS[i % numAgents].color
          var nr = numMemories <= 8 ? 8 : 6
          h += '<g id="mem-'+i+'" opacity="0"><circle cx="'+mp.x+'" cy="'+mp.y+'" r="'+nr+'" fill="#111113" stroke="'+col+'" stroke-width="1.2"/>'
          if (fs > 0) {
            var lr = mp.r + 18
            var lx = Math.round(CX + lr * Math.cos(mp.a))
            var ly = Math.round(CY + lr * Math.sin(mp.a))
            var anc = Math.abs(Math.cos(mp.a)) < 0.25 ? 'middle' : Math.cos(mp.a) > 0 ? 'start' : 'end'
            var ddy = Math.sin(mp.a) > 0.4 ? 10 : Math.sin(mp.a) < -0.4 ? -4 : 4
            h += '<text x="'+lx+'" y="'+(ly+ddy)+'" text-anchor="'+anc+'" fill="#a1a1aa" font-size="'+fs+'" font-family="\'Inter\', sans-serif">'+MEM_LABELS[i]+'</text>'
          }
          h += '</g>'
        }
        for (var i = 0; i < numMemories - 1; i++) {
          var m1 = memPos(i), m2 = memPos(i + 1)
          h += '<line id="mem-edge-'+i+'" x1="'+m1.x+'" y1="'+m1.y+'" x2="'+m2.x+'" y2="'+m2.y+'" stroke="#22d3ee" stroke-width="0.8" stroke-opacity="0" stroke-dasharray="3 3"/>'
        }
        h += '</g>'
        var bw = numAgents <= 4 ? 148 : 128, bh = numAgents <= 4 ? 60 : 50
        var afs = numAgents <= 4 ? 13 : 11
        for (var i = 0; i < numAgents; i++) {
          var p = agentPos(i), a = AGENTS[i]
          h += '<g id="agent-'+i+'">'
          h += '<rect x="'+(p.x - bw/2)+'" y="'+(p.y - bh/2)+'" width="'+bw+'" height="'+bh+'" rx="12" fill="#111113" stroke="'+a.color+'" stroke-width="1.5" stroke-opacity="0.6"/>'
          h += '<text x="'+p.x+'" y="'+(p.y - 2)+'" text-anchor="middle" fill="#fafafa" font-size="'+afs+'" font-weight="700" font-family="\'Inter\', sans-serif">'+a.name+'</text>'
          h += '<text id="status-'+i+'" x="'+p.x+'" y="'+(p.y + 15)+'" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="\'JetBrains Mono\', monospace">idle</text>'
          h += '<circle cx="'+(p.x - bw/2 + 16)+'" cy="'+(p.y - bh/2 + 12)+'" r="3.5" fill="'+a.color+'" opacity="0.6"/>'
          h += '</g>'
        }
        svgEl.innerHTML = h
      }
      function buildSteps() {
        steps = []
        var stored = []
        for (var i = 0; i < numMemories; i++) {
          var ag = i % numAgents
          steps.push({ t: 'store', a: ag, m: i })
          stored.push({ a: ag, m: i })
          if (i >= 1 && i % 2 === 1) {
            var ra = (ag + 1) % numAgents
            var cands = stored.filter(function(s) { return s.a !== ra })
            if (cands.length > 0) {
              var tgt = cands[Math.max(0, cands.length - 2)]
              steps.push({ t: 'recall', a: ra, m: tgt.m, from: tgt.a })
            }
          }
        }
        if (stored.length >= 2) steps.push({ t: 'link', a: 1 % numAgents, m1: 0, m2: 1 })
        steps.push({ t: 'summary' })
      }
      function animLine(idx, on) {
        var el = document.getElementById('line-' + idx)
        if (el) { el.setAttribute('stroke-opacity', on ? '0.6' : '0.15'); el.setAttribute('stroke-width', on ? '2' : '1.5') }
      }
      function showMem(idx, show) {
        var el = document.getElementById('mem-' + idx)
        if (el) el.setAttribute('opacity', show ? '1' : '0')
      }
      function showEdge(idx, show) {
        var el = document.getElementById('mem-edge-' + idx)
        if (el) el.setAttribute('stroke-opacity', show ? '0.4' : '0')
      }
      function setSt(idx, text) {
        var el = document.getElementById('status-' + idx)
        if (el) el.textContent = text
      }
      function setGlow(idx, on) {
        var g = document.getElementById('agent-' + idx)
        if (!g) return
        var r = g.querySelector('rect')
        r.setAttribute('stroke-opacity', on ? '1' : '0.6')
        r.setAttribute('stroke-width', on ? '2.5' : '1.5')
      }
      function particle(ai, tx, ty, rev) {
        var el = document.getElementById('particle-' + ai)
        if (!el) return
        var p = agentPos(ai)
        var fx = rev ? tx : p.x, fy = rev ? ty : p.y
        var ex = rev ? p.x : tx, ey = rev ? p.y : ty
        el.setAttribute('opacity', '1')
        var anim = el.animate([
          { transform: 'translate('+fx+'px, '+fy+'px)' },
          { transform: 'translate('+ex+'px, '+ey+'px)' }
        ], { duration: 800, easing: 'ease-in-out' })
        anim.onfinish = function() { el.setAttribute('opacity', '0') }
      }
      function addLog(html, cls) {
        var d = document.createElement('div')
        d.className = 'flow-log-entry ' + (cls || '')
        d.innerHTML = html
        logEl.appendChild(d)
        logEl.scrollTop = logEl.scrollHeight
      }
      function doStep() {
        currentStep++
        if (currentStep >= steps.length) { stopAuto(); return }
        var s = steps[currentStep]
        var ag = AGENTS[s.a]
        var mp = s.m !== undefined ? memPos(s.m) : null
        if (s.t === 'store') {
          addLog('<span style="color:'+ag.color+'">'+ag.name+'</span> &rarr; <code>icm_memory_store</code> "'+MEM_LABELS[s.m]+'"', 'flow-log-store')
          setSt(s.a, 'storing...'); setGlow(s.a, true); animLine(s.a, true); particle(s.a, mp.x, mp.y, false)
          setTimeout(function() { showMem(s.m, true); if (s.m > 0) showEdge(s.m - 1, true); setSt(s.a, 'stored'); animLine(s.a, false); setGlow(s.a, false) }, 900)
        } else if (s.t === 'recall') {
          var from = AGENTS[s.from]
          addLog('<span style="color:'+ag.color+'">'+ag.name+'</span> &rarr; <code>icm_memory_recall</code> "'+MEM_LABELS[s.m]+'"', 'flow-log-recall')
          setSt(s.a, 'recalling...'); setGlow(s.a, true); animLine(s.a, true)
          var me = document.getElementById('mem-' + s.m)
          if (me) me.querySelector('circle').setAttribute('stroke-width', '2.5')
          particle(s.a, mp.x, mp.y, true)
          setTimeout(function() { addLog('&nbsp;&nbsp;<span style="color:#4ade80">Found:</span> "'+MEM_LABELS[s.m]+'" <span style="color:#a1a1aa">(from '+from.name+')</span>', 'flow-log-found'); setSt(s.a, 'recalled'); animLine(s.a, false); setGlow(s.a, false); if (me) me.querySelector('circle').setAttribute('stroke-width', '1.2') }, 900)
        } else if (s.t === 'link') {
          addLog('<span style="color:'+ag.color+'">'+ag.name+'</span> &rarr; <code>icm_memoir_link</code> "'+MEM_LABELS[s.m1]+'" &rarr; "'+MEM_LABELS[s.m2]+'"', 'flow-log-store')
          setSt(s.a, 'linking...'); setGlow(s.a, true); animLine(s.a, true)
          var edgeCount = 0
          for (var i = 0; i < numMemories - 1; i++) {
            var e = document.getElementById('mem-edge-' + i)
            if (e && e.getAttribute('stroke-opacity') !== '0') edgeCount++
          }
          setTimeout(function() { addLog('&nbsp;&nbsp;<span style="color:#a78bfa">Graph:</span> '+numMemories+' concepts, '+(edgeCount+1)+' edges &mdash; knowledge grows across agents', 'flow-log-found'); setSt(s.a, 'linked'); animLine(s.a, false); setGlow(s.a, false) }, 900)
        } else if (s.t === 'summary') {
          for (var i = 0; i < numAgents; i++) setSt(i, 'idle')
          addLog('<strong>'+numAgents+' agents, '+numMemories+' memories, 1 shared brain.</strong> Context persists across tools and sessions.', 'flow-log-info')
        }
      }
      function resetAll() {
        stopAuto(); currentStep = -1; buildSVG(); buildSteps()
        logEl.innerHTML = '<div class="flow-log-entry flow-log-info">Click <strong>Auto</strong> to watch the demo or <strong>Step</strong> to go one action at a time.</div>'
      }
      function startAuto() {
        if (currentStep >= steps.length - 1) resetAll()
        playing = true
        playBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg> Pause'
        playBtn.classList.add('playing')
        doStep()
        autoInterval = setInterval(function() { if (currentStep >= steps.length - 1) { stopAuto(); return } doStep() }, 2200)
      }
      function stopAuto() {
        playing = false; clearInterval(autoInterval); autoInterval = null
        playBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> Auto'
        playBtn.classList.remove('playing')
      }
      playBtn.addEventListener('click', function() { playing ? stopAuto() : startAuto() })
      stepBtn.addEventListener('click', function() { stopAuto(); if (currentStep >= steps.length - 1) resetAll(); else doStep() })
      resetBtn.addEventListener('click', resetAll)
      document.querySelectorAll('#param-agents .flow-param-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('#param-agents .flow-param-btn').forEach(function(b) { b.classList.remove('active') })
          btn.classList.add('active'); numAgents = parseInt(btn.dataset.val); resetAll()
        })
      })
      document.querySelectorAll('#param-memories .flow-param-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('#param-memories .flow-param-btn').forEach(function(b) { b.classList.remove('active') })
          btn.classList.add('active'); numMemories = parseInt(btn.dataset.val); resetAll()
        })
      })
      buildSVG(); buildSteps()
    })()
  </script>
</Layout>

<style is:global>
  @import '../../styles/landing.css';
</style>
