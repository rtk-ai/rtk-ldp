---
import Layout from '../../layouts/Layout.astro'
import SearchModal from '../../components/global/SearchModal.astro'
import SiteHeader from '../../components/global/SiteHeader.astro'

const buildDate = new Date().toISOString().split('T')[0]

const schemaOrg = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ICM — Infinite Context Memory',
    description:
      'Permanent persistent memory for AI agents. Single binary, SQLite storage, MCP native with 22 tools. Episodic memories with temporal decay, semantic knowledge graphs, and hybrid BM25+vector search. Auto-configures 14 AI editors including Claude Code, Cursor, Windsurf, and VS Code.',
    url: 'https://www.rtk-ai.app/icm/',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    datePublished: '2025-09-01',
    dateModified: buildDate,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    license: 'https://opensource.org/licenses/MIT',
    downloadUrl: 'https://github.com/rtk-ai/icm',
    author: { '@type': 'Organization', name: 'RTK AI', url: 'https://www.rtk-ai.app' },
    featureList: [
      'Episodic memories with temporal decay — 4 importance levels, automatic memory aging',
      'Semantic knowledge graphs with typed relations (depends_on, contradicts, refines)',
      'Hybrid BM25 + vector cosine similarity search (384-dim BAAI/bge-small embeddings)',
      '22 MCP tools exposed via Model Context Protocol',
      'Auto-configures 14 AI editors via icm init (Claude Code, Cursor, Windsurf, VS Code, and more)',
      '100% local — SQLite storage, local embeddings, zero API keys, zero cloud',
      'Single binary, zero dependencies — no Docker, no Python, no Qdrant',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is ICM — Infinite Context Memory?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'ICM is permanent persistent memory for AI agents. It is a single Rust binary with SQLite storage that exposes 22 MCP tools. ICM provides three memory systems: episodic memories with temporal decay (4 importance levels), semantic knowledge graphs with typed relations, and a correction feedback system. It auto-configures 14 AI editors including Claude Code, Cursor, Windsurf, VS Code, Gemini Code Assist, Zed, Amp, Amazon Q, Cline, Roo Code, Kilo Code, Codex CLI, and OpenCode. 100% local, zero API keys required, MIT licensed.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does ICM memory decay work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'ICM uses 4 importance levels: critical (never decays), high (slow decay), medium (normal decay), and low (fast decay — fades in days). Memories are stored with a timestamp and importance score. Trivial details like debug notes fade naturally while critical architectural decisions remain permanently. This mirrors human memory prioritization without manual cleanup.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does ICM compare to Mem0 and other AI memory tools?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mem0 ($24M funded, 41K GitHub stars) requires cloud infrastructure and API keys. Zep/Graphiti (20K stars) requires Neo4j and an OpenAI API key. mcp-memory-service (1.3K stars) is MCP-native but lacks knowledge graphs and temporal decay. ICM offers a single Rust binary with SQLite — no Docker, no Python, no cloud. It combines hybrid BM25+vector search, knowledge graphs, and temporal decay in one zero-dependency binary that installs with a single cargo install command.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I install ICM and connect it to my AI editor?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Install with: cargo install icm — then run icm init to auto-configure your editors. ICM detects and configures 14 editors automatically. For Claude Code specifically, it registers ICM as an MCP server exposing all 22 tools. No manual JSON editing required.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is ICM data stored locally or in the cloud?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'ICM is 100% local. All data is stored in a SQLite file on your machine. Embeddings use BAAI/bge-small (384-dimensional vectors) running locally with no API calls. No data leaves your machine. No API keys required.',
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to give AI agents persistent memory with ICM',
    description: 'Install ICM and connect it to your AI editor in under 2 minutes. Single binary, zero dependencies.',
    totalTime: 'PT2M',
    estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
    tool: [{ '@type': 'HowToTool', name: 'Terminal / Command Line' }],
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Install ICM',
        text: 'Run: cargo install icm — or install from source: cargo install --git https://github.com/rtk-ai/icm. Pre-built binaries are also available on the GitHub releases page.',
        url: 'https://www.rtk-ai.app/icm/#install',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Auto-configure your editors',
        text: 'Run icm init to auto-detect and configure up to 14 AI editors. Claude Code, Cursor, Windsurf, VS Code/Copilot, Gemini Code Assist, Zed, Amp, Amazon Q, Cline, Roo Code, Kilo Code, Codex CLI, and OpenCode are all supported.',
        url: 'https://www.rtk-ai.app/icm/#install',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Store and recall memories',
        text: 'Use icm_memory_store with a topic, content, and importance level (critical/high/medium/low). Retrieve context with icm_memory_recall using natural language queries. Build knowledge graphs with icm_memoir_create and icm_memoir_link.',
        url: 'https://www.rtk-ai.app/icm/how-it-works/#demo',
      },
    ],
  },
]
---
<Layout
  title="ICM — The SQLite of AI Memory | rtk-ai"
  description="ICM is permanent memory for AI agents. Single binary, zero dependencies, MCP native. Episodic memories with temporal decay and semantic knowledge graphs."
  image="/og-icm-banner.png"
  schemaOrg={schemaOrg}
>
  <a href="#main-content" class="skip-to-content">Skip to content</a>

  <SiteHeader variant="product" product="icm" />

  <main id="main-content">

    <script is:inline>
      var _icmMap={'#models':'/icm/how-it-works/#models','#demo':'/icm/how-it-works/#demo','#tools':'/icm/how-it-works/#tools','#compare':'/icm/vs/'};
      if(location.hash&&_icmMap[location.hash])location.replace(_icmMap[location.hash]);
    </script>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">Open Source &middot; MIT License &middot; Written in Rust</div>
      <h1>Your AI forgets everything.<br><span class="gradient-text">ICM fixes that.</span></h1>
      <p class="hero-sub">
        <strong>ICM</strong> gives AI agents real persistent memory.
        Episodic memories with temporal decay, semantic knowledge graphs, hybrid search &mdash; in a single binary.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">&infin;</span>
          <span class="stat-label">session memory</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-value">0</span>
          <span class="stat-label">context lost</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-value">22</span>
          <span class="stat-label">MCP tools</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-value">1</span>
          <span class="stat-label">single binary</span>
        </div>
      </div>
      <img src="/og-icm-banner.png" alt="ICM — Infinite Context Memory" class="icm-hero-banner" loading="eager" width="1200" height="630">
      <div class="hero-cta">
        <a href="#install" class="btn btn-primary">Install ICM</a>
        <a href="https://github.com/rtk-ai/icm" class="btn btn-ghost" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Star on GitHub
        </a>
        <a href="https://discord.gg/RySmvNF5kF" class="btn btn-ghost" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/></svg>
          Join Discord
        </a>
      </div>
    </section>

    <!-- Features -->
    <section class="features" id="features">
      <div class="section-inner">
        <h2>Why ICM?</h2>
        <p class="section-sub">Your AI restarts from zero every session. ICM changes that.</p>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#22d3ee" stroke-width="2"/><path d="M12 6v6l4 2" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <h3>Temporal Decay</h3>
            <p>Memories fade naturally based on importance. Critical decisions stay forever. Trivial details disappear. Like human memory.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="#22d3ee" stroke-width="2"/><polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke="#a78bfa" stroke-width="2"/><line x1="12" y1="22.08" x2="12" y2="12" stroke="#a78bfa" stroke-width="2"/></svg>
            </div>
            <h3>Knowledge Graphs</h3>
            <p>Memoirs organize concepts with typed relations: depends_on, contradicts, refines. Structured knowledge, not flat notes.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8" stroke="#22d3ee" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <h3>Hybrid Search</h3>
            <p>BM25 keyword search (30%) + vector cosine similarity (70%) via sqlite-vec. Find memories by meaning, not just keywords.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke="#22d3ee" stroke-width="2" stroke-linejoin="round"/><path d="M2 17l10 5 10-5" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12l10 5 10-5" stroke="#22d3ee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>MCP Native</h3>
            <p>22 tools exposed via Model Context Protocol. <code>icm init</code> auto-configures 14 editors: Claude Code, Cursor, Windsurf, VS Code/Copilot, Gemini Code Assist, Zed, Amp, Amazon Q, Cline, Roo Code, Kilo Code, Codex CLI, OpenCode, and more.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="#22d3ee" stroke-width="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16" r="1" fill="#22d3ee"/></svg>
            </div>
            <h3>100% Local</h3>
            <p>Everything stays on your machine. SQLite storage, local embeddings (384-dim via BAAI/bge-small), no cloud, no API keys.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="#22d3ee" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3>Single Binary</h3>
            <p>One <code>cargo install</code>. No Docker, no Python, no Qdrant, no Redis. Just a Rust binary and a SQLite file.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="#22d3ee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 10h8M8 14h4" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <h3>Feedback System</h3>
            <p>Record corrections when AI predictions are wrong. Search past feedback to avoid repeating mistakes. Track correction stats over time.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" stroke="#22d3ee" stroke-width="2"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z" stroke="#a78bfa" stroke-width="2"/></svg>
            </div>
            <h3>Auto-Extraction Hooks</h3>
            <p>Three lifecycle hooks &mdash; PostToolUse, PreCompact, UserPromptSubmit &mdash; automatically extract and store context at zero LLM cost.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="icm-faq" id="faq">
      <div class="section-inner">
        <h2>Frequently asked</h2>
        <p class="section-sub">Everything you need to know about ICM.</p>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary class="faq-q">What is ICM?</summary>
            <div class="faq-a">
              <p>ICM is permanent persistent memory for AI agents, packaged as a single Rust binary with SQLite storage. It exposes 22 MCP tools and provides three complementary memory systems: episodic memories with temporal decay, semantic knowledge graphs with typed relations, and a correction feedback loop.</p>
              <p>Run <code>icm init</code> to auto-configure up to 14 editors including Claude Code, Cursor, Windsurf, VS Code/Copilot, Gemini Code Assist, Zed, Amp, Amazon Q, Cline, Roo Code, Kilo Code, Codex CLI, and OpenCode. 100% local, zero API keys, MIT licensed.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary class="faq-q">How does memory decay work?</summary>
            <div class="faq-a">
              <p>Four importance levels control decay speed: <code>critical</code> (never decays), <code>high</code> (slow decay), <code>medium</code> (normal decay), and <code>low</code> (fades in days). Memories are stored with a timestamp and importance score, so critical architectural decisions stay permanently while trivial debug notes disappear without any manual cleanup.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary class="faq-q">How do I install ICM?</summary>
            <div class="faq-a">
              <p>Run <code>cargo install icm</code>, then <code>icm init</code> to auto-configure your editors. ICM detects and registers itself as an MCP server for all 14 supported editors automatically. No manual JSON editing required. <a href="#install">See the full install guide below.</a></p>
            </div>
          </details>
          <details class="faq-item">
            <summary class="faq-q">Is my data stored locally or in the cloud?</summary>
            <div class="faq-a">
              <p>100% local. All data lives in a SQLite file on your machine. Embeddings run locally using BAAI/bge-small (384-dim vectors) with no external API calls. Nothing leaves your machine, ever.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary class="faq-q">How does ICM compare to Mem0 and other tools?</summary>
            <div class="faq-a">
              <p>Mem0 ($24M raised) requires cloud infrastructure and API keys. Zep/Graphiti requires Neo4j plus an OpenAI API key. mcp-memory-service is MCP native but has no knowledge graphs or temporal decay. ICM gives you all three memory systems in a single zero-dependency Rust binary, no cloud required. <a href="/icm/vs/">See the full comparison.</a></p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section class="install" id="install">
      <div class="section-inner">
        <h2>Install in seconds</h2>
        <p class="section-sub">Single binary. No Docker, no Python, no external services.</p>
        <div class="install-grid">
          <div class="install-card install-primary">
            <h3>Via Cargo</h3>
            <p>From crates.io</p>
            <div class="code-block">
              <code>cargo install icm</code>
              <button class="copy-btn" data-copy="cargo install icm" aria-label="Copy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </div>
          </div>
          <div class="install-card">
            <h3>From Source</h3>
            <p>Latest from GitHub</p>
            <div class="code-block">
              <code>cargo install --git https://github.com/rtk-ai/icm</code>
              <button class="copy-btn" data-copy="cargo install --git https://github.com/rtk-ai/icm" aria-label="Copy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </div>
          </div>
          <div class="install-card">
            <h3>Pre-built Binaries</h3>
            <p>macOS, Linux, Windows</p>
            <div class="code-block">
              <a href="https://github.com/rtk-ai/icm/releases/latest" target="_blank" rel="noopener" class="releases-link">Download from Releases &rarr;</a>
            </div>
          </div>
        </div>
        <div class="install-setup">
          <h3>Then auto-configure your editor</h3>
          <div class="code-block code-block-wide">
            <code>icm init</code>
            <button class="copy-btn" data-copy="icm init" aria-label="Copy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            </button>
          </div>
          <p class="install-note">Auto-detects and configures 14 editors: Claude Code, Cursor, Windsurf, VS Code/Copilot, Gemini Code Assist, Zed, Amp, Amazon Q, Cline, Roo Code, Kilo Code, Codex CLI, and OpenCode. Your AI agent can now store memories, build knowledge graphs, record feedback, and recall context across sessions.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="section-inner">
        <h2>Your AI starts from zero.<br><span class="gradient-text">Every. Single. Time.</span></h2>
        <p class="section-sub">Install ICM in seconds, then explore how the memory systems work.</p>
        <div class="hero-cta">
          <a href="#install" class="btn btn-primary">Install ICM</a>
          <a href="/icm/how-it-works/" class="btn btn-ghost">How it works &rarr;</a>
        </div>
        <div class="social-share">
          <span class="share-label">Share ICM</span>
          <div class="share-links">
            <a href="https://x.com/intent/tweet?text=ICM%20%E2%80%94%20The%20SQLite%20of%20AI%20memory.%20Permanent%20memory%20for%20AI%20agents%2C%20single%20binary%2C%20zero%20API%20keys.&url=https%3A%2F%2Fgithub.com%2Frtk-ai%2Ficm" target="_blank" rel="noopener nofollow" class="share-btn" aria-label="Share on X">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://bsky.app/intent/compose?text=ICM%20%E2%80%94%20The%20SQLite%20of%20AI%20memory.%20Permanent%20memory%20for%20AI%20agents%2C%20single%20binary%2C%20zero%20API%20keys.%20https%3A%2F%2Fgithub.com%2Frtk-ai%2Ficm" target="_blank" rel="noopener nofollow" class="share-btn" aria-label="Share on Bluesky">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.601 3.495 6.186 3.245-3.775.547-7.052 2.48-4.452 7.378 2.294 3.796 5.057 4.755 7.642.38C12 17.764 12 14.568 12 14.568s0 3.196 2 6.682c2.585 4.375 5.348 3.416 7.642-.38 2.6-4.898-.677-6.831-4.452-7.378 2.585.25 5.401-.618 6.186-3.245.246-.828.624-5.788.624-6.479 0-.688-.139-1.86-.902-2.203-.659-.299-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8z"/></svg>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fgithub.com%2Frtk-ai%2Ficm" target="_blank" rel="noopener nofollow" class="share-btn" aria-label="Share on LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
