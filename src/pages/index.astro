---
import Layout from '../layouts/Layout.astro'
import SiteHeader from '../components/global/SiteHeader.astro'
import Hero from '../components/landing/Hero.astro'
import Problem from '../components/landing/Problem.astro'
import DemoSlideshow from '../components/landing/DemoSlideshow.astro'
import Install from '../components/landing/Install.astro'
import Cta from '../components/landing/Cta.astro'
import SiteFooter from '../components/global/SiteFooter.astro'
import I18nScript from '../components/global/I18nScript.astro'
import SearchModal from '../components/global/SearchModal.astro'

const faqItems = [
  {
    q: 'What is RTK (Rust Token Killer)?',
    a: 'RTK is an open-source CLI tool that compresses command outputs before they reach the AI context window. It reduces token usage by 60-90% with zero configuration changes, enabling longer AI coding sessions and lower API costs. RTK is written in Rust, MIT licensed, and works transparently with Claude Code, Cursor, and any terminal-based AI assistant.',
  },
  {
    q: 'How many tokens does RTK actually save?',
    a: 'Based on measurements across 2,900+ real-world commands, RTK removes an average of 89% of CLI output noise. Command-level savings: cargo test (91.8% savings), git status (80.8%), find (78.3%), grep (49.5%). A developer who ran 15,720 commands saved 138 million tokens over several weeks — tracked live via rtk gain.',
  },
  {
    q: 'Is RTK free? Are there usage limits?',
    a: 'RTK is completely free. It is open source under the MIT license, with source code available on GitHub at github.com/rtk-ai/rtk. There are no usage limits, no API keys required, no telemetry, and no accounts. RTK Cloud (waitlist) will offer additional team features.',
  },
  {
    q: 'Which AI coding tools and commands does RTK support?',
    a: 'RTK works with Claude Code (Anthropic), Cursor, Gemini CLI, Aider, and any AI assistant that reads terminal output. It supports all major CLI commands: cargo test, pytest, go test, git diff, git status, git log, grep, find, ls, pnpm list, tsc, eslint, prisma, docker, kubectl, and more.',
  },
  {
    q: 'How does RTK work without changing my workflow?',
    a: 'Running rtk init --global installs a PreToolUse hook in Claude Code that automatically rewrites Bash commands to rtk equivalents at the proxy layer. You continue using your normal commands — RTK intercepts and compresses the output before it enters the context window. No manual changes to prompts or workflows are needed.',
  },
  {
    q: 'Does RTK affect code quality or AI reasoning accuracy?',
    a: 'No. RTK removes verbose boilerplate and repetitive output noise, not meaningful content. Test failures, error messages, diffs, and stack traces are preserved in full. The AI receives the same essential information with 89% less noise, which typically improves reasoning quality by reducing context pollution.',
  },
]

let version = ''
try {
  const headers: Record<string, string> = { 'User-Agent': 'rtk-landing' }
  const token = process.env.GITHUB_TOKEN
  if (token) headers['Authorization'] = `Bearer ${token}`
  const rel = await fetch('https://api.github.com/repos/rtk-ai/rtk/releases/latest', { headers })
  if (rel.ok) {
    const data = await rel.json()
    if (data.tag_name) version = data.tag_name.replace(/^v/, '')
  }
} catch {}

const buildDate = new Date().toISOString().split('T')[0]

// Single @graph block — links all entities, preferred by Google & AI search engines
const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.rtk-ai.app/#organization',
      name: 'RTK AI',
      url: 'https://www.rtk-ai.app',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.rtk-ai.app/favicon.svg',
      },
      sameAs: [
        'https://github.com/rtk-ai',
        'https://discord.gg/RySmvNF5kF',
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://www.rtk-ai.app/#software',
      name: 'RTK — Rust Token Killer',
      description:
        'RTK compresses CLI command outputs before they reach the AI context window, reducing token usage by 60-90% with zero config changes. Open source, MIT licensed, written in Rust.',
      url: 'https://www.rtk-ai.app',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      ...(version ? { softwareVersion: version } : {}),
      releaseNotes: 'https://github.com/rtk-ai/rtk/blob/master/CHANGELOG.md',
      datePublished: '2025-01-01',
      dateModified: buildDate,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      license: 'https://opensource.org/licenses/MIT',
      downloadUrl: 'https://github.com/rtk-ai/rtk',
      author: { '@id': 'https://www.rtk-ai.app/#organization' },
      featureList: [
        '89% average CLI token noise removed — measured across 2,900+ real commands',
        '3x longer AI coding sessions by reducing context pollution',
        'Supports all major CLI commands: cargo test, git status, grep, find, ls, docker, kubectl, and more',
        'Auto-rewrite hook for Claude Code via PreToolUse',
        'Real-time analytics dashboard with rtk gain',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://www.rtk-ai.app/#faq',
      mainEntity: faqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
    {
      '@type': 'HowTo',
      '@id': 'https://www.rtk-ai.app/#howto-install',
      name: 'How to install RTK and reduce Claude Code token usage by 60-90%',
      description:
        'Install RTK (Rust Token Killer) in under 2 minutes and activate the automatic command compression hook. No workflow changes required.',
      totalTime: 'PT2M',
      estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
      tool: [{ '@type': 'HowToTool', name: 'Terminal / Command Line' }],
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Install RTK',
          text: 'Run the one-liner installer: curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh — supports macOS and Linux. Alternatively install via Homebrew: brew install rtk.',
          url: 'https://www.rtk-ai.app/#install',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Activate the auto-rewrite hook',
          text: 'Run rtk init --global to install the PreToolUse hook in Claude Code. This transparently rewrites Bash tool calls to rtk equivalents, compressing output before it reaches the context window.',
          url: 'https://www.rtk-ai.app/#install',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Verify your token savings',
          text: 'Run rtk gain to open the analytics dashboard. View total tokens saved, per-command savings percentages, and daily/weekly/monthly trends.',
          url: 'https://www.rtk-ai.app/#install',
        },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://www.rtk-ai.app/#webpage',
      url: 'https://www.rtk-ai.app/',
      name: 'RTK — Rust Token Killer',
      description: 'RTK reduces Claude Code token usage by 60-90% — measured across 2,900+ real commands. 89% avg noise removed, 3x longer sessions, zero config. Free, open source, MIT, written in Rust.',
      inLanguage: 'en',
      dateModified: buildDate,
      isPartOf: { '@type': 'WebSite', name: 'RTK', url: 'https://www.rtk-ai.app' },
      publisher: { '@id': 'https://www.rtk-ai.app/#organization' },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.hero-context', '.faq-answer', '.session-note'],
      },
    },
  ],
}
---
<script is:inline>
  var _ldgMap={'#proof':'/savings/','#compare':'/vs/','#cloud':'/cloud/','#share-gain':'/cloud/'};
  if(location.hash&&_ldgMap[location.hash])location.replace(_ldgMap[location.hash]);
</script>
<Layout
  title="RTK — Rust Token Killer"
  description="RTK reduces Claude Code token usage by 60-90% — measured across 2,900+ real commands. 89% avg noise removed, 3x longer sessions, zero config. MIT licensed."
  schemaOrg={schemaOrg}
>
  <a href="#main-content" class="skip-to-content">Skip to content</a>
  <SiteHeader />
  <main id="main-content">
    <Hero />
    <Problem />
    <DemoSlideshow />
    <Install />
    <Cta />

    <!-- FAQ Section -->
    <section class="faq-section" id="faq">
      <div class="section-inner">
        <h2 class="reveal">Frequently asked questions</h2>
        <div class="faq-list">
          {faqItems.map(({ q, a }) => (
            <details class="faq-item reveal">
              <summary class="faq-question">{q}</summary>
              <p class="faq-answer">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Starred by carousel -->
    <section class="starred-section">
      <p class="starred-label" data-i18n="starred.label">Starred by developers at</p>
      <div class="starred-track-wrapper">
        <div class="starred-track">
          <span class="starred-name">Apple</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">AWS</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Barclays</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Bosch</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Canva</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Cisco</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Datadog</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Deloitte</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">ENI</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Google</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Hitachi</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">HPE</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">IBM</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Meta</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Microsoft</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">OVHcloud</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Zendesk</span><span class="starred-sep">&middot;</span>
          <!-- Duplicate for seamless loop -->
          <span class="starred-name">Apple</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">AWS</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Barclays</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Bosch</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Canva</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Cisco</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Datadog</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Deloitte</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">ENI</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Google</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Hitachi</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">HPE</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">IBM</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Meta</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Microsoft</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">OVHcloud</span><span class="starred-sep">&middot;</span>
          <span class="starred-name">Zendesk</span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SearchModal />
  <I18nScript />
</Layout>

<style is:global>
  @import '../styles/landing.css';
</style>

<script>
  import { initReveal } from '../scripts/reveal'
  import { initCopyButtons } from '../scripts/copy'
  import { initSlideshow } from '../scripts/slideshow'

  initReveal()
  initCopyButtons()
  initSlideshow()
</script>
