---
import PageV3 from '../layouts/PageV3.astro'
---
<PageV3
  title="404: Page not found · RTK"
  description="This page does not exist."
  mainClass="nf"
>
  <div class="lp3-container nf-inner">
    <p class="lp3-eyebrow reveal">404</p>
    <h1 class="lp3-h2 reveal">Page <em>not found</em></h1>
    <p class="nf-desc reveal">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="nf-actions reveal">
      <a href="/" class="lp3-btn lp3-btn-primary">
        Back to home <span class="arr" aria-hidden="true">→</span>
      </a>
      <a href="/guide/" class="lp3-btn lp3-btn-ghost">Browse docs</a>
    </div>
  </div>
</PageV3>

<style>
  /* Centred in the viewport minus the fixed nav; the V3 system supplies the
     type, buttons and container — this only handles the vertical centring. */
  .nf {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
  }
  .nf-inner {
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .nf-inner :global(.lp3-eyebrow) { justify-content: center; }
  .nf-desc {
    max-width: 34rem;
    margin: 1.25rem auto 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .nf-actions {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
</style>
