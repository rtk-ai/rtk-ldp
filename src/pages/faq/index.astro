---
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../../components/global/SiteHeader.astro'
import SiteFooter from '../../components/global/SiteFooter.astro'
import SearchModal from '../../components/global/SearchModal.astro'

const buildDate = new Date().toISOString().split('T')[0]

const faqItems = [
  {
    q: 'What is RTK (Rust Token Killer)?',
    a: 'RTK is an open-source CLI tool that compresses command outputs before they reach the AI context window. It reduces token usage by 60-90% with zero configuration changes, enabling longer AI coding sessions and lower API costs. RTK is written in Rust, MIT licensed, and works transparently with Claude Code, Cursor, and any terminal-based AI assistant.',
  },
  {
    q: 'How many tokens does RTK actually save?',
    a: 'Based on measurements across 2,900+ real-world commands, RTK removes an average of 89% of CLI output noise. Command-level savings: cargo test (91.8% savings), git status (80.8%), find (78.3%), grep (49.5%). A developer who ran 15,720 commands saved 138 million tokens over several weeks, tracked live via rtk gain.',
  },
  {
    q: 'Is RTK free? Are there usage limits?',
    a: 'RTK is completely free. It is open source under the MIT license, with source code available on GitHub at github.com/rtk-ai/rtk. There are no usage limits, no API keys required, no telemetry, and no accounts. RTK Cloud (waitlist) will offer additional team features.',
  },
  {
    q: 'Which AI coding tools and commands does RTK support?',
    a: 'RTK works with Claude Code (Anthropic), Cursor, Gemini CLI, Aider, and any AI assistant that reads terminal output. It supports all major CLI commands: cargo test, pytest, go test, git diff, git status, git log, grep, find, ls, pnpm list, tsc, eslint, prisma, docker, kubectl, and more.',
  },
  {
    q: 'How does RTK work without changing my workflow?',
    a: 'Running rtk init --global installs a PreToolUse hook in Claude Code that automatically rewrites Bash commands to rtk equivalents at the proxy layer. You continue using your normal commands. RTK intercepts and compresses the output before it enters the context window, with no manual changes to prompts or workflows needed.',
  },
  {
    q: 'Does RTK affect code quality or AI reasoning accuracy?',
    a: 'No. RTK removes verbose boilerplate and repetitive output noise, not meaningful content. Test failures, error messages, diffs, and stack traces are preserved in full. The AI receives the same essential information with 89% less noise, which typically improves reasoning quality by reducing context pollution.',
  },
]

const schemaOrg = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'RTK', item: 'https://www.rtk-ai.app/' },
      { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://www.rtk-ai.app/faq/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: 'https://www.rtk-ai.app/faq/',
    dateModified: buildDate,
    mainEntity: faqItems.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
]
---
<Layout
  title="RTK FAQ — Frequently Asked Questions | rtk-ai"
  description="Answers to the most common questions about RTK: what it does, how it saves tokens, which tools it supports, and how to get started."
  schemaOrg={schemaOrg}
>
  <a href="#main-content" class="skip-to-content">Skip to content</a>

  <SiteHeader />

  <main id="main-content">

    <section class="subpage-hero">
      <nav class="rtk-subnav" aria-label="RTK pages">
        <a href="/">RTK</a>
        <span aria-hidden="true">/</span>
        <strong>FAQ</strong>
      </nav>
      <h1>Frequently asked questions.</h1>
      <p class="subpage-sub">
        Everything you need to know about RTK — what it does, how it works, and what it costs (nothing).
      </p>
    </section>

    <section class="faq-page-section">
      <div class="section-inner">
        <div class="faq-list">
          {faqItems.map(({ q, a }) => (
            <details class="faq-item">
              <summary class="faq-question">{q}</summary>
              <p class="faq-answer">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="section-inner">
        <h2>Still have questions?<br><span style="color:var(--accent)">Read the docs.</span></h2>
        <p class="section-sub">Full reference for every command, hook, and configuration option.</p>
        <div class="subpage-cta">
          <a href="/docs/" class="btn btn-primary">Read the docs &rarr;</a>
          <a href="https://discord.gg/RySmvNF5kF" class="btn btn-ghost" target="_blank" rel="noopener">Ask on Discord</a>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />
  <SearchModal />
</Layout>

<style is:global>
  @import '../../styles/landing.css';

  .rtk-subnav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .rtk-subnav a { color: var(--accent); text-decoration: none; }
  .rtk-subnav a:hover { text-decoration: underline; }
  .rtk-subnav span { color: var(--text-dim); }
  .rtk-subnav strong { color: var(--text); }

  .subpage-hero {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 120px 24px 60px;
    text-align: left;
  }
  .subpage-hero h1 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .subpage-sub {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 0 36px;
    line-height: 1.7;
  }
  .subpage-cta {
    display: flex;
    gap: var(--space-3);
    justify-content: flex-start;
    flex-wrap: wrap;
  }
</style>

<style>
  .faq-page-section { background: var(--bg-card); }
</style>
