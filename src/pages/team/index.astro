  .map(([handle, contributions]) => ({
    handle: handle as string,
    contributions: contributions as number,
    url: `https://github.com/${handle}`,
  }))
  .sort((a, b) => b.contributions - a.contributions || a.handle.localeCompare(b.handle))

const shown = contributors.filter((c) => c.contributions > 1)
const singleCommit = contributors.length - shown.length

// No dedicated LinkedIn icon component exists — inline the mark.
const linkedinSvg =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>'

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': siteUrl + '/#organization',
  name: 'RTK AI Labs',
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: siteUrl + '/brand/logo.png', width: 256, height: 256 },
  description: 'RTK AI Labs builds tools for AI coding agents, makers of RTK (Rust Token Killer).',
  member: [
    ...labs.map((m) => ({
      '@type': 'Person',
      name: m.name,
      jobTitle: `${m.role} / ${m.founderRole}`,
      image: siteUrl + m.photo,
      sameAs: [m.linkedin, m.github].filter(Boolean),
      worksFor: { '@id': siteUrl + '/#organization' },
    })),
    ...maintainers.map((m) => ({
      '@type': 'Person',
      name: m.name,
      jobTitle: 'Open Source Maintainer',
      sameAs: [m.linkedin, m.github],
    })),
  ],
}
---
<PageV3
  title="Team · RTK AI Labs | rtk-ai"
  description="Meet RTK AI Labs: the team and open-source community building RTK, the Rust Token Killer for AI coding agents."
  schemaOrg={schemaOrg}
  mainClass="tm"
>
  <section class="tm-head">
    <div class="lp3-container">
      <p class="lp3-eyebrow reveal">Team</p>
      <h1 class="lp3-h2 tm-title reveal">The team behind <span class="tm-accent">RTK</span></h1>
      <p class="lp3-lede reveal">A small team building tools for AI coding agents</p>
    </div>
  </section>

  <section class="lp3-section tm-sec" aria-labelledby="tm-labs">
    <div class="lp3-container">
      <h2 id="tm-labs" class="lp3-h2 tm-h2 reveal">RTK AI Labs</h2>

      <ul class="tm-people" role="list">
        {labs.map((member) => (
          <li class="tm-person reveal">
            <img
              class="tm-avatar"
              src={member.photo}
              alt={`Portrait of ${member.name}`}
              width="72"
              height="72"
              loading="lazy"
            />
            <h3 class="tm-name">{member.name}</h3>
            <p class="tm-role">
              {member.role}
              <span class="tm-role-founder">{member.founderRole}</span>
            </p>
            <div class="tm-social">
              {member.github && (
                <a class="tm-social-btn" href={member.github} target="_blank" rel="noopener" aria-label={`${member.name} on GitHub`}>
                  <IconGitHub size={15} />
                  GitHub
                </a>
              )}
              <a class="tm-social-btn" href={member.linkedin} target="_blank" rel="noopener" aria-label={`${member.name} on LinkedIn`}>
                <Fragment set:html={linkedinSvg} />
                LinkedIn
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="lp3-section tm-sec tm-sec-line" aria-labelledby="tm-maintainers">
    <div class="lp3-container tm-split">
      <div class="tm-split-head">
        <h2 id="tm-maintainers" class="lp3-h2 tm-h2 reveal">Open Source <em>Maintainers</em></h2>
        <p class="lp3-lede tm-sub reveal">Core contributors who keep RTK moving.</p>
      </div>

      <ul class="tm-rows" role="list">
        {maintainers.map((m) => (
          <li class="tm-row reveal">
            <span class="tm-row-name">{m.name}</span>
            <span class="tm-row-links">
              <a class="tm-icon-link" href={m.github} target="_blank" rel="noopener" aria-label={`${m.name} on GitHub`}>
                <IconGitHub size={15} />
              </a>
              <a class="tm-icon-link" href={m.linkedin} target="_blank" rel="noopener" aria-label={`${m.name} on LinkedIn`}>
                <Fragment set:html={linkedinSvg} />
              </a>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="lp3-section tm-sec tm-sec-line" aria-labelledby="tm-contributors">
    <div class="lp3-container">
      <div class="tm-contrib-head">
        <h2 id="tm-contributors" class="lp3-h2 tm-h2 reveal">Open Source <em>Contributors</em></h2>
        <p class="lp3-lede tm-sub reveal">
          {contributors.length} people have shipped code, docs or fixes to RTK. The {shown.length} with
          more than one contribution are listed here, ranked by commit count; the other {singleCommit} are
          on GitHub.
          <span class="tm-synced">Last synced {contributorsSyncedAt}</span>
        </p>
      </div>

      <ul class="tm-chips reveal" role="list">
        {shown.map((c) => (
          <li>
            <a
              class="tm-chip"
              href={c.url}
              target="_blank"
              rel="noopener"
              aria-label={`${c.handle} on GitHub, ${c.contributions} contributions`}
            >
              <IconGitHub size={13} />
              {c.handle}
              <span class="tm-chip-count">{c.contributions}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="tm-actions reveal">
        <a
          class="lp3-btn lp3-btn-ghost lp3-btn-sm"
          href="https://github.com/rtk-ai/rtk/graphs/contributors"
          target="_blank"
          rel="noopener"
        >
          View all {contributors.length} contributors
          <span class="arr" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</PageV3>

<style>

  .tm-head {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: calc(var(--lp3-sec-pad) * 0.34);
  }
  .tm-title {
    max-width: 20ch;
  }
  .tm-accent {
    color: var(--accent);
  }
  @supports (color: color-mix(in srgb, red 50%, blue)) {
    .tm-accent {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent) 62%, var(--text-bright)) 0%,
        var(--accent) 58%,
        color-mix(in srgb, var(--accent-hover) 88%, var(--bg)) 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 18px var(--accent-dim));
    }
  }

  .tm-sec {
    padding-top: calc(var(--lp3-sec-pad) * 0.52);
    padding-bottom: calc(var(--lp3-sec-pad) * 0.52);
  }
  .tm-sec-line {
    border-top: 1px solid var(--lp3-line);
  }
  .tm-h2 {
    font-size: clamp(1.6rem, 2.4vw, 2.25rem);
  }
  .tm-sub {
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .tm-people {
    list-style: none;
    margin: clamp(3rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .tm-person {
    padding: 0 clamp(1.25rem, 2.5vw, 2.5rem);
    border-left: 1px solid var(--lp3-line);
  }
  .tm-person:first-child {
    padding-left: 0;
    border-left: none;
  }
  .tm-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--lp3-line-strong);
    display: block;
    margin-bottom: 1.5rem;
  }
  .tm-name {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .tm-role {
    margin: 0.55rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .tm-role-founder {
    display: block;
    margin-top: 0.3rem;
    color: var(--text-dim);
  }
  .tm-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .tm-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--lp3-line);
    border-radius: 999px;
    background: var(--lp3-surface);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .tm-social-btn:hover {
    color: var(--text-bright);
    border-color: var(--lp3-line-strong);
    background: var(--lp3-surface-hover);
    text-decoration: none;
  }

  .tm-split {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }
  .tm-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--lp3-line);
  }
  .tm-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 14px 4px;
    border-bottom: 1px solid var(--lp3-line);
  }
  .tm-row-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
  }
  .tm-row-links {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .tm-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--lp3-line);
    color: var(--text-muted);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .tm-icon-link:hover {
    color: var(--text-bright);
    border-color: var(--lp3-line-strong);
    background: var(--lp3-surface-hover);
  }

  .tm-contrib-head {
    max-width: 40rem;
  }
  .tm-synced {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }
  .tm-chips {
    list-style: none;
    margin: clamp(2.5rem, 4vw, 3.5rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tm-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--lp3-line);
    border-radius: 999px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .tm-chip:hover {
    color: var(--text-bright);
    border-color: var(--lp3-line-strong);
    background: var(--lp3-surface-hover);
    text-decoration: none;
  }
  .tm-chip-count {
    color: var(--text-dim);
    font-size: 0.7rem;
  }
  .tm-actions {
    margin-top: clamp(2rem, 3.5vw, 3rem);
  }

  @media (max-width: 960px) {
    .tm-split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 760px) {
    .tm-people {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }
    .tm-person {
      padding: 2.5rem 0 0;
      border-left: none;
      border-top: 1px solid var(--lp3-line);
    }
    .tm-person:first-child {
      padding-top: 0;
      border-top: none;
    }
    .tm-avatar {
      margin-bottom: 1.25rem;
    }
    .tm-social-btn,
    .tm-icon-link {
      min-height: 44px;
    }
    .tm-icon-link {
      width: 44px;
      height: 44px;
    }
    .tm-chip {
      min-height: 38px;
    }
  }
</style>
