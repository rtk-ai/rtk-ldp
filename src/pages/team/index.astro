    linkedin: 'https://www.linkedin.com/in/patrick-szymkowiak/',
    github: 'https://github.com/pszymkowiak',
  },
  {
    name: 'Thomas Grauwin',
    role: 'COO',
    founderRole: 'Co-founder',
    photo: '/assets/pictures/thomas.webp',
    linkedin: 'https://www.linkedin.com/in/thomasgrauwin/',
    github: '',
