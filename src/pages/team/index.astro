const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': siteUrl + '/#organization',
  name: 'RTK AI Labs',
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: siteUrl + '/brand/logo.png', width: 256, height: 256 },
  description: 'RTK AI Labs builds tools for AI coding agents — makers of RTK (Rust Token Killer).',
  member: [
    ...labs.map((m) => ({
      '@type': 'Person',
      name: m.name,
      jobTitle: `${m.role} / ${m.founderRole}`,
      image: siteUrl + m.photo,
      sameAs: [m.linkedin, m.github].filter(Boolean),
      worksFor: { '@id': siteUrl + '/#organization' },
    })),
    ...maintainers.map((m) => ({
      '@type': 'Person',
      name: m.name,
      jobTitle: 'Open Source Maintainer',
      sameAs: [m.linkedin, m.github],
    })),
  ],
}
---
<Layout
  title="Team — RTK AI Labs | rtk-ai"
  description="Meet RTK AI Labs — the team and open-source community building RTK, the Rust Token Killer for AI coding agents."
  image="/og-image.png"
  schemaOrg={schemaOrg}
>
  <a href="#main-content" class="skip-to-content">Skip to content</a>

  <SiteHeader />

  <main id="main-content" class="team-page">
    <section class="team-hero">
      <div class="section-inner">
        <div class="team-badge">Team</div>
        <h1>The team behind <span class="gradient-text">RTK</span></h1>
        <p class="team-sub">A small team building tools for AI coding agents</p>
      </div>
    </section>

    <section class="team-block">
      <div class="section-inner">
        <h2 class="team-block-title">RTK AI Labs</h2>
        <ul class="team-grid" role="list">
          {labs.map((member) => (
            <li class="team-card">
              <img
                class="team-avatar"
                src={member.photo}
                alt={`Portrait of ${member.name}`}
                width="72"
                height="72"
                loading="lazy"
              />
              <div class="team-identity">
                <h3 class="team-name">{member.name}</h3>
                <p class="team-role">
                  {member.role}
                  <span class="team-role-founder">{member.founderRole}</span>
                </p>
              </div>
              <div class="social-row">
                {member.github && (
                  <a class="social-btn" href={member.github} target="_blank" rel="noopener" aria-label={`${member.name} on GitHub`}>
                    <IconGitHub size={15} />
                    GitHub
                  </a>
                )}
                <a class="social-btn" href={member.linkedin} target="_blank" rel="noopener" aria-label={`${member.name} on LinkedIn`}>
                  <Fragment set:html={linkedinSvg} />
                  LinkedIn
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="team-maintainers">
      <div class="section-inner">
        <h2 class="maintainers-title">Open Source Maintainers</h2>
        <p class="maintainers-sub">Core contributors who keep RTK moving.</p>
        <ul class="maintainers-list" role="list">
          {maintainers.map((m) => (
            <li class="maintainer-row">
              <span class="maintainer-name">{m.name}</span>
              <span class="maintainer-links">
                <a class="maintainer-link" href={m.github} target="_blank" rel="noopener" aria-label={`${m.name} on GitHub`}>
                  <IconGitHub size={15} />
                </a>
                <a class="maintainer-link" href={m.linkedin} target="_blank" rel="noopener" aria-label={`${m.name} on LinkedIn`}>
                  <Fragment set:html={linkedinSvg} />
                </a>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="team-contributors">
      <div class="section-inner">
        <h2 class="contributors-title">Open Source Contributors</h2>
        <p class="contributors-sub">
          {contributors.length} people have shipped code, docs or fixes to RTK, ranked by commit count.
          <span class="contributors-synced">Last synced {contributorsSyncedAt}</span>
        </p>
        <ul class="contributors-list" role="list">
          {contributors.map((c) => (
            <li>
              <a
                class="contributor-chip"
                href={c.url}
                target="_blank"
                rel="noopener"
                aria-label={`${c.handle} on GitHub — ${c.contributions} contributions`}
              >
                <IconGitHub size={13} />
                {c.handle}
                <span class="contributor-count">{c.contributions}</span>
              </a>
            </li>
          ))}
          <li>
            <a
              class="contributor-chip contributor-chip--all"
              href="https://github.com/rtk-ai/rtk/graphs/contributors"
              target="_blank"
              rel="noopener"
            >
              View all contributors
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SearchModal />
</Layout>

<style is:global>
  @import '../../styles/landing.css';

  /* ── Team page ───────────────────────────────────────────────────── */
  .team-page { padding-top: 60px; }

  .team-hero {
    padding: 72px 0 8px;
    text-align: center;
    background:
      radial-gradient(ellipse 600px 240px at 50% 0%, var(--accent-glow), transparent 70%),
      var(--bg);
  }
  .team-badge {
    display: inline-block;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    background: var(--accent-dim);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .team-hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 14px;
  }
  .team-sub {
    color: var(--text-muted);
    font-size: var(--text-lg);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* RTK AI Labs block */
  .team-block { padding: 56px 0 72px; }
  .team-block-title {
    text-align: center;
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin-bottom: 32px;
  }
  .team-block-title::after {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--cyan));
    margin: 10px auto 0;
    border-radius: var(--radius-pill);
    opacity: 0.8;
  }
  .team-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 620px;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }
  .team-card {
    display: flex;
    align-items: center;
    gap: 18px;
    text-align: left;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .team-card:hover {
    border-color: var(--border-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover), var(--shadow-glow-green);
  }
  .team-avatar {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-light);
  }
  .team-identity {
    flex: 1;
    min-width: 0;
  }
  .team-card .social-row {
    flex-shrink: 0;
  }
  .team-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-bright);
    margin: 0 0 3px;
  }
  .team-role {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    margin: 0;
  }
  .team-role-founder {
    display: block;
    margin-top: 1px;
    color: var(--text-dim);
    font-size: var(--text-xs);
  }

  /* Shared social pill buttons */
  .social-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    background: var(--bg-card-hover);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .social-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  /* ── RTK Open Source Maintainers (smaller block) ─────────────────── */
  .team-maintainers {
    padding: 56px 0 88px;
    text-align: center;
  }
  .maintainers-title {
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    font-weight: 800;
    color: var(--text-bright);
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .maintainers-sub {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: 0 0 28px;
  }
  .maintainers-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 540px;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    overflow: hidden;
  }
  .maintainer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
  }
  .maintainer-row:last-child { border-bottom: none; }
  .maintainer-name {
    color: var(--text);
    font-size: var(--text-base);
    font-weight: 600;
  }
  .maintainer-links {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .maintainer-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    background: var(--bg-card-hover);
    color: var(--text-muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .maintainer-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── RTK Open Source Contributors (lightweight chips) ────────────── */
  .team-contributors {
    padding: 56px 0 96px;
    text-align: center;
  }

  .team-maintainers,
  .team-contributors {
    position: relative;
  }
  .team-maintainers::before,
  .team-contributors::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(760px, 88%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }
  .contributors-title {
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    font-weight: 800;
    color: var(--text-bright);
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .contributors-sub {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: 0 0 24px;
  }
  .contributors-synced {
    display: block;
    margin-top: 4px;
    color: var(--text-dim);
    font-size: var(--text-xs);
  }
  .contributor-count {
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    background: var(--bg-elevated);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
  }
  .contributors-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 760px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .contributor-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-card);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .contributor-chip:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--bg-card-hover);
    text-decoration: none;
  }
  .contributor-chip--all {
    font-family: inherit;
    font-weight: 600;
    color: var(--accent);
    border-color: var(--accent-dim);
    background: var(--accent-dim);
  }
  .contributor-chip--all span { transition: transform 0.2s; }
  .contributor-chip--all:hover { background: var(--accent-dim); border-color: var(--accent); }
  .contributor-chip--all:hover span { transform: translateX(2px); }

  @media (max-width: 640px) {
    .team-hero { padding: 48px 0 4px; }
    .team-block { padding: 40px 0 56px; }
    .team-block-title { margin-bottom: 24px; }
    .team-card {
      flex-wrap: wrap;
      gap: 14px;
      padding: 16px;
    }
    .team-avatar { width: 60px; height: 60px; }
    .team-card .social-row { width: 100%; }
    .team-sub { font-size: var(--text-base); }
    .team-maintainers { padding: 40px 0 56px; }
    .team-contributors { padding: 40px 0 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card { transition: none; }
    .team-card:hover { transform: none; }
  }
</style>
