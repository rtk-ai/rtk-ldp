---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../../components/global/SiteHeader.astro'
import SiteFooter from '../../components/global/SiteFooter.astro'
import SearchModal from '../../components/global/SearchModal.astro'

const siteUrl = 'https://www.rtk-ai.app'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': siteUrl + '/blog/#blog',
  name: 'RTK Blog',
  url: siteUrl + '/blog/',
  description: 'Engineering notes on token efficiency and AI coding agents from the RTK team.',
  publisher: {
    '@type': 'Organization',
    name: 'RTK AI',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: siteUrl + '/brand/logo.png', width: 256, height: 256 },
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: `${siteUrl}/blog/${post.id}/`,
    datePublished: post.data.date.toISOString().split('T')[0],
  })),
}
---

<Layout
  title="Blog — RTK | rtk-ai"
  description="Engineering notes from the RTK team — token efficiency, CLI output compression, and building tools for AI coding agents like Claude Code."
  schemaOrg={schemaOrg}
>
  <a href="#main-content" class="skip-to-content">Skip to content</a>

  <SiteHeader />

  <main id="main-content" class="blog-page">
    <section class="blog-hero">
      <div class="section-inner">
        <div class="blog-badge">Blog</div>
        <h1>The <span class="blog-accent">RTK</span> blog</h1>
        <p class="blog-sub">Engineering notes on token efficiency and AI coding agents</p>
      </div>
    </section>

    <section class="blog-list-section">
      <div class="section-inner">
        <ul class="blog-list" role="list">
          {posts.map((post) => (
            <li>
              <article class="blog-card">
                <a href={`/blog/${post.id}/`} class="blog-card-link">
                  <div class="blog-card-meta">
                    <time datetime={post.data.date.toISOString().split('T')[0]}>{formatDate(post.data.date)}</time>
                    {post.data.tags.map((tag) => (
                      <span class="blog-tag">{tag}</span>
                    ))}
                  </div>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <span class="blog-card-read">Read article &rarr;</span>
                </a>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SearchModal />
</Layout>

<style is:global>
  @import '../../styles/landing.css';

  .blog-page { padding-top: 60px; }

  .blog-hero {
    padding: 72px 0 8px;
    text-align: center;
    background:
      radial-gradient(ellipse 600px 240px at 50% 0%, var(--accent-glow), transparent 70%),
      var(--bg);
  }
  .blog-badge {
    display: inline-block;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    background: var(--accent-dim);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .blog-hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 14px;
  }
  .blog-accent { color: var(--accent); }
  .blog-sub {
    color: var(--text-muted);
    font-size: var(--text-lg);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .blog-list-section { padding: 56px 0 96px; }
  .blog-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .blog-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .blog-card:hover {
    border-color: var(--border-light);
    background: var(--bg-card-hover);
  }
  .blog-card-link {
    display: block;
    padding: 26px 28px;
    text-decoration: none;
    color: inherit;
  }
  .blog-card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius);
  }
  .blog-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
  }
  .blog-card-meta time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }
  .blog-tag {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-dim);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .blog-card-title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--text-bright);
  }
  .blog-card-desc {
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: 1.65;
    margin-bottom: 14px;
  }
  .blog-card-read {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .blog-card-link { padding: 20px; }
  }
</style>
