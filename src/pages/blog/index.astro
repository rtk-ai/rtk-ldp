---
import { getCollection } from 'astro:content'
import PageV3 from '../../layouts/PageV3.astro'

const siteUrl = 'https://www.rtk-ai.app'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': siteUrl + '/blog/#blog',
  name: 'RTK Blog',
  url: siteUrl + '/blog/',
  description: 'Engineering notes on token efficiency and AI coding agents from the RTK team.',
  publisher: {
    '@type': 'Organization',
    name: 'RTK AI',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: siteUrl + '/brand/logo.png', width: 256, height: 256 },
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: `${siteUrl}/blog/${post.id}/`,
    datePublished: post.data.date.toISOString().split('T')[0],
  })),
}
---

<PageV3
  title="Blog · RTK | rtk-ai"
  description="Engineering notes from the RTK team: token efficiency, CLI output compression, and building tools for AI coding agents like Claude Code."
  schemaOrg={schemaOrg}
  mainClass="bx"
>

  <header class="bx-head">
    <div class="lp3-container">
      <p class="lp3-eyebrow reveal">Blog</p>
      <h1 class="lp3-h2 bx-title reveal">The <span class="bx-accent">RTK</span> blog</h1>
      <p class="bx-sub reveal">Engineering notes on token efficiency and AI coding agents</p>
    </div>
  </header>

  <section class="bx-listing">
    <div class="lp3-container">
      <ul class="bx-list" role="list">
        {posts.map((post) => (
          <li class="reveal">
            <article class="bx-item">
              <a href={`/blog/${post.id}/`} class="bx-link">
                <div class="bx-meta">
                  <time datetime={post.data.date.toISOString().split('T')[0]}>{formatDate(post.data.date)}</time>
                  {post.data.tags.map((tag) => (
                    <span class="bx-tag">{tag}</span>
                  ))}
                </div>
                <div class="bx-body">
                  <h2 class="bx-item-title">{post.data.title}</h2>
                  <p class="bx-item-desc">{post.data.description}</p>
                  <span class="bx-read">Read article <span class="arr" aria-hidden="true">&rarr;</span></span>
                </div>
              </a>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PageV3>

<style>
  .bx-head {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(2.75rem, 5vw, 4rem);
  }
  .bx-head .bx-title {
    font-size: clamp(2.1rem, 3.4vw, 3.1rem);
  }
  .bx-accent { color: var(--accent); }
  @supports (color: color-mix(in srgb, red 50%, blue)) {
    .bx-accent {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent) 62%, var(--text-bright)) 0%,
        var(--accent) 58%,
        color-mix(in srgb, var(--accent-hover) 88%, var(--bg)) 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 22px var(--accent-dim));
    }
  }
  .bx-sub {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .bx-listing {
    padding-bottom: clamp(7rem, 11vw, 11rem);
  }
  .bx-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--lp3-line);
  }
  .bx-item {
    border-bottom: 1px solid var(--lp3-line);
  }
  .bx-link {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    padding: clamp(1.75rem, 3vw, 2.5rem) 4px;
    text-decoration: none;
    color: inherit;
    transition: background 0.25s ease;
  }
  .bx-link:hover {
    background: linear-gradient(90deg, var(--lp3-surface-hover), transparent 78%);
  }
  .bx-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--lp3-radius-sm);
  }

  .bx-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.3rem;
  }
  .bx-meta time {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .bx-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 5px 9px;
    border: 1px solid var(--lp3-line);
    border-radius: 999px;
    color: var(--text-dim);
  }

  .bx-body { min-width: 0; }
  .bx-body .bx-item-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.3;
    color: var(--text-bright);
  }
  .bx-item-desc {
    margin: 0.75rem 0 0;
    max-width: 36rem;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .bx-read {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--accent);
  }
  .bx-read .arr { transition: transform 0.2s ease; }
  .bx-link:hover .bx-read .arr { transform: translateX(3px); }
  .bx-link:hover .bx-read { color: var(--accent-hover); }

  @media (max-width: 760px) {
    .bx-link {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .bx-meta { padding-top: 0; }
  }
</style>
