---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../../components/global/SiteHeader.astro'
import SiteFooter from '../../components/global/SiteFooter.astro'
import SearchModal from '../../components/global/SearchModal.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)

const siteUrl = 'https://www.rtk-ai.app'
const canonical = `${siteUrl}/blog/${post.id}/`
const isoDate = post.data.date.toISOString().split('T')[0]
const displayDate = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
const readingMinutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 220))

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': canonical + '#article',
  headline: post.data.title,
  description: post.data.description,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: isoDate,
  dateModified: isoDate,
  image: siteUrl + (post.data.image ?? '/og-image.png'),
  author: {
    '@type': post.data.author === 'RTK AI Labs' ? 'Organization' : 'Person',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'RTK AI',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: siteUrl + '/brand/logo.png', width: 256, height: 256 },
  },
  isPartOf: { '@type': 'Blog', '@id': siteUrl + '/blog/#blog', name: 'RTK Blog' },
}
---

<Layout
  title={`${post.data.title} — RTK Blog`}
  description={post.data.description}
  image={post.data.image ?? '/og-image.png'}
  ogType="article"
  schemaOrg={schemaOrg}
>
  <a href="#main-content" class="skip-to-content">Skip to content</a>

  <SiteHeader />

  <main id="main-content" class="blog-page">
    <article class="blog-article">
      <header class="blog-article-header">
        <a href="/blog/" class="blog-back">&larr; All articles</a>
        <div class="blog-article-meta">
          <time datetime={isoDate}>{displayDate}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{post.data.author}</span>
          <span aria-hidden="true">&middot;</span>
          <span>{readingMinutes} min read</span>
        </div>
        <h1>{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <div class="blog-article-tags">
            {post.data.tags.map((tag) => (
              <span class="blog-tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="blog-prose">
        <Content />
      </div>

      <footer class="blog-article-footer">
        <a href="/blog/" class="blog-back">&larr; All articles</a>
      </footer>
    </article>
  </main>

  <SiteFooter />
  <SearchModal />
</Layout>

<style is:global>
  @import '../../styles/landing.css';

  .blog-page { padding-top: 60px; }

  .blog-article {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 24px 96px;
  }

  .blog-article-header { margin-bottom: 40px; }
  .blog-back {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    margin-bottom: 28px;
  }
  .blog-back:hover { color: var(--accent-hover); }
  .blog-back:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .blog-article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
    margin-bottom: 14px;
  }
  .blog-article-header h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-bright);
    margin-bottom: 16px;
  }
  .blog-article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .blog-tag {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-dim);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .blog-prose { font-size: var(--text-base); }
  .blog-prose h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin: 44px 0 14px;
  }
  .blog-prose h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-bright);
    margin: 32px 0 10px;
  }
  .blog-prose p {
    color: var(--text-muted);
    line-height: 1.75;
    margin: 0 0 18px;
  }
  .blog-prose strong { color: var(--text); }
  .blog-prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .blog-prose a:hover { color: var(--accent-hover); }
  .blog-prose ul,
  .blog-prose ol {
    color: var(--text-muted);
    line-height: 1.75;
    margin: 0 0 18px;
    padding-left: 24px;
  }
  .blog-prose li { margin-bottom: 6px; }
  .blog-prose code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    padding: 2px 6px;
  }
  .blog-prose pre {
    background: var(--bg-card) !important;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    overflow-x: auto;
    margin: 0 0 20px;
  }
  .blog-prose pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: var(--text-sm);
  }
  .blog-prose blockquote {
    border-left: 3px solid var(--accent);
    padding: 4px 0 4px 18px;
    margin: 0 0 20px;
  }
  .blog-prose blockquote p { color: var(--text-dim); }
  .blog-prose img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 20px;
    font-size: var(--text-sm);
  }
  .blog-prose th,
  .blog-prose td {
    border: 1px solid var(--border);
    padding: 8px 12px;
    text-align: left;
  }
  .blog-prose th { color: var(--text); background: var(--bg-card); }
  .blog-prose td { color: var(--text-muted); }
  .blog-prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 36px 0;
  }

  .blog-article-footer {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .blog-article-footer .blog-back { margin-bottom: 0; }
</style>
