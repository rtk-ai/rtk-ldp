---
import { getCollection, render } from 'astro:content'
import PageV3 from '../../layouts/PageV3.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)

const siteUrl = 'https://www.rtk-ai.app'
const canonical = `${siteUrl}/blog/${post.id}/`
const isoDate = post.data.date.toISOString().split('T')[0]
const displayDate = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
const readingMinutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 220))

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': canonical + '#article',
  headline: post.data.title,
  description: post.data.description,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: isoDate,
  dateModified: isoDate,
  image: siteUrl + (post.data.image ?? '/og-image.png'),
  author: {
    '@type': post.data.author === 'RTK AI Labs' ? 'Organization' : 'Person',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'RTK AI',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: siteUrl + '/brand/logo.png', width: 256, height: 256 },
  },
  isPartOf: { '@type': 'Blog', '@id': siteUrl + '/blog/#blog', name: 'RTK Blog' },
}
---

<PageV3
  title={`${post.data.title} · RTK Blog`}
  description={post.data.description}
  image={post.data.image ?? '/og-image.png'}
  ogType="article"
  schemaOrg={schemaOrg}
  mainClass="bp"
>

  <article class="bp-article">
    <div class="lp3-container">
      <div class="bp-col">
        <header class="bp-head">
          <a href="/blog/" class="bp-back reveal"><span class="arr" aria-hidden="true">&larr;</span> All articles</a>
          <div class="bp-meta reveal">
            <time datetime={isoDate}>{displayDate}</time>
            <span aria-hidden="true">&middot;</span>
            <span>{post.data.author}</span>
            <span aria-hidden="true">&middot;</span>
            <span>{readingMinutes} min read</span>
          </div>
          <h1 class="lp3-h2 bp-title reveal">{post.data.title}</h1>
          {post.data.tags.length > 0 && (
            <div class="bp-tags reveal">
              {post.data.tags.map((tag) => (
                <span class="bp-tag">{tag}</span>
              ))}
            </div>
          )}
        </header>

        <div class="bp-prose">
          <Content />
        </div>

        <footer class="bp-foot">
          <a href="/blog/" class="bp-back"><span class="arr" aria-hidden="true">&larr;</span> All articles</a>
        </footer>
      </div>
    </div>
  </article>
</PageV3>

<style>
  /* ── Reading column ─────────────────────────────────────────────────
     One measure for the whole article (~68 characters at the body size), so
     header, prose, figures and footer share the same left and right edge. */
  .bp-article {
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
    padding-bottom: clamp(6rem, 10vw, 9rem);
  }
  .bp-col {
    max-width: 68ch;
    margin: 0 auto;
  }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .bp-head {
    padding-bottom: clamp(2rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--lp3-line);
  }
  .bp-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .bp-back .arr { transition: transform 0.2s ease; }
  .bp-back:hover { color: var(--accent); }
  .bp-back:hover .arr { transform: translateX(-3px); }
  .bp-back:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .bp-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  /* Two classes deep on purpose: `.lp3 h1` (margin: 0) and `.lp3-h2` live in
     the shared V3 bundle, which loads after this page's styles — a
     single-class override would lose. Same for the prose headings below. */
  .bp-head .bp-title {
    margin-top: 1.25rem;
    font-size: clamp(1.95rem, 3.2vw, 2.7rem);
    line-height: 1.14;
  }

  .bp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  /* Quiet hairline chips — mint stays budgeted for CTAs (§2). */
  .bp-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 5px 9px;
    border: 1px solid var(--lp3-line);
    border-radius: 999px;
    color: var(--text-dim);
  }

  /* ── Prose ──────────────────────────────────────────────────────────
     :global() because the markdown body is rendered by <Content />, which
     Astro's scoping never touches. Everything stays under .bp-prose so no
     rule escapes this page. */
  .bp-prose {
    margin-top: clamp(2.5rem, 4vw, 3.25rem);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-muted);
  }
  .bp-col .bp-prose :global(> :first-child) { margin-top: 0; }

  .bp-col .bp-prose :global(h2) {
    font-family: var(--lp3-font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text-bright);
    margin: 3.5rem 0 1rem;
  }
  .bp-col .bp-prose :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--text);
    margin: 2.5rem 0 0.75rem;
  }
  .bp-col .bp-prose :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin: 2rem 0 0.6rem;
  }

  .bp-prose :global(p) { margin: 0 0 1.35rem; }
  .bp-prose :global(strong) { color: var(--text); font-weight: 600; }
  .bp-prose :global(em) { color: var(--text); }

  .bp-prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .bp-prose :global(a:hover) {
    color: var(--accent-hover);
    text-decoration-color: var(--accent-hover);
  }
  .bp-prose :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 3px;
  }

  .bp-prose :global(ul),
  .bp-prose :global(ol) {
    margin: 0 0 1.35rem;
    padding-left: 1.35rem;
  }
  .bp-prose :global(li) { margin-bottom: 0.5rem; }
  .bp-prose :global(li::marker) { color: var(--text-dim); }

  .bp-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text);
    background: var(--lp3-surface);
    border: 1px solid var(--lp3-line);
    border-radius: 5px;
    padding: 1px 6px;
  }
  .bp-prose :global(pre) {
    background: var(--lp3-surface) !important;
    border: 1px solid var(--lp3-line);
    border-radius: var(--lp3-radius);
    padding: 18px 20px;
    overflow-x: auto;
    margin: 0 0 1.75rem;
    font-size: 0.86rem;
    line-height: 1.65;
  }
  .bp-prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  .bp-prose :global(blockquote) {
    margin: 0 0 1.75rem;
    padding: 0.85rem 1.35rem;
    border-left: 1px solid var(--lp3-line-strong);
    background: linear-gradient(90deg, var(--lp3-surface-hover), transparent 85%);
  }
  .bp-prose :global(blockquote p) { margin: 0; color: var(--text-dim); }

  .bp-prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    border: 1px solid var(--lp3-line);
    border-radius: var(--lp3-radius);
  }
  .bp-prose :global(figure) { margin: 2rem 0; }

  .bp-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.75rem;
    font-size: 0.9rem;
  }
  .bp-prose :global(th),
  .bp-prose :global(td) {
    border-bottom: 1px solid var(--lp3-line);
    padding: 10px 12px;
    text-align: left;
  }
  /* No text-transform anywhere in the prose — the markdown owns its casing. */
  .bp-prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text);
  }
  .bp-prose :global(td) { color: var(--text-muted); }

  .bp-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--lp3-line);
    margin: 3rem 0;
  }

  /* ── Footer ─────────────────────────────────────────────────────────── */
  .bp-foot {
    margin-top: clamp(3rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--lp3-line);
  }

  @media (max-width: 560px) {
    .bp-prose { font-size: 1rem; }
    .bp-col .bp-prose :global(h2) { font-size: 1.4rem; margin-top: 2.75rem; }
  }
</style>
