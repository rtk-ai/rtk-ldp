---
/**
 * PageV3 — the shell every non-landing page uses so the whole site shares one
 * design system: V3 chrome (NavV3 + FooterV3 + search), the `.lp3` token scope,
 * and landing-v3.css.
 *
 * Page bodies supply only their content and their own scoped <style>. They must
 * not re-import landing.css (the legacy system) or mount their own header,
 * footer or search modal — this layout owns all four.
 */
import Layout from './Layout.astro'
import NavV3 from '../components/landing/v3/NavV3.astro'
import FooterV3 from '../components/landing/v3/FooterV3.astro'
import SearchModal from '../components/global/SearchModal.astro'
import { getRepoFacts } from '../lib/github'
import type { Lang } from '../lib/i18n'

interface Props {
  title: string
  description: string
  lang?: Lang
  /** JSON-LD passed straight through to Layout */
  schemaOrg?: unknown
  canonicalUrl?: string
  /** OG image + og:type, passed straight through to Layout (articles need them) */
  image?: string
  ogType?: 'website' | 'article'
  /** extra class on the <main> element, for page-specific layout hooks */
  mainClass?: string
}

const { title, description, lang = 'en', schemaOrg, canonicalUrl, mainClass, image, ogType } = Astro.props
const { starsLabel } = await getRepoFacts()
---
<Layout
  title={title}
  description={description}
  schemaOrg={schemaOrg}
  canonicalUrl={canonicalUrl}
  image={image}
  ogType={ogType}
>
  <Fragment slot="head">
    <!-- V3 display faces. The `ital` axis is required: without it the browser
         has no italic file and fakes one by slanting the uprights, which is a
         visibly cruder letterform than Geist's real italic. Loaded here so every page using this layout gets the
         same typography — without it the .lp3 font tokens fall back to DM Sans
         and headings silently render in the wrong face. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Geist:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
    />
    <slot name="head" />
  </Fragment>

  <div class="lp3">
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <NavV3 starsLabel={starsLabel} lang={lang} />
    <main id="main-content" class:list={['lp3-page', mainClass]}>
      <slot />
    </main>
    <FooterV3 lang={lang} />
    <SearchModal />
  </div>
</Layout>

<style is:global>
  @import '../styles/landing-v3.css';

  /* The nav is fixed (64px), so inner pages clear it here rather than each
     page inventing its own offset. The landing does not use this layout — its
     hero owns the top of the viewport. */
  .lp3-page {
    padding-top: 64px;
    /* Content pages are denser than the landing story — one statement per
       section there, lists and tables here — so they run a tighter rhythm
       than the landing's --lp3-sec-pad. Set once, inherited by every page. */
    --lp3-sec-pad: clamp(4rem, 6vw, 6.5rem);
    --lp3-head-gap: clamp(2.25rem, 4vw, 3.25rem);
  }
</style>

<script>
  import { initReveal } from '../scripts/reveal'
  import { initCopyButtons } from '../scripts/copy'

  initReveal()
  initCopyButtons()
</script>
